{
  "name": "@open-ds/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook for the Open DS components: every component in every scheme, brand and mode, with each scheme's when-to-use rules next to it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --dir ../tokens build && storybook dev -p 6006",
    "build": "pnpm --dir ../tokens build && storybook build -o storybook-static --quiet",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@open-ds/ui": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.70.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.1.13",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.6"
  }
}
