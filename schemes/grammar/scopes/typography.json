            "heading-weight",
            "text-weight"
          ]
        },
        {
          "id": "core-editorial",
          "label": "Core and editorial display",
          "creates": [
            "heading-size",
            "body-size",
            "small-text-size",
            "heading-weight",
            "text-weight"
          ]
        },
        {
          "id": "core-expressive",
