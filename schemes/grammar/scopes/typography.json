          "creates": [
            "heading-size",
            "body-size",
            "small-text-size",
            "heading-weight",
            "text-weight"
          ]
        }
      ]
    },
    {
      "id": "typography.count",
      "method": "count",
      "text": "How many steps does the type scale take?",
      "description": "Few sizes keep a dense screen calm. More sizes give long pages a clear hierarchy.",
      "options": [
        {
          "id": "few",
          "label": "Only the steps the screens need",
          "description": "The scale keeps the few sizes the screens use, and nothing in between.",
          "creates": []
        },
        {
          "id": "some",
          "label": "One step per kind of text",
          "description": "One size each for caption, body, heading, title and display.",
          "creates": []
        },
        {
          "id": "many",
          "label": "Fine steps, so pages can set their own rhythm",
          "description": "Many close sizes, so a page can tune its hierarchy and pace.",
          "creates": []
        }
      ]
    },
    {
      "id": "typography.definition",
      "method": "definition",
      "text": "How are sizes and line heights defined?",
      "description": "A ratio scale with line heights on the grid, a ratio scale with proportional line heights, or fixed steps.",
      "options": [
        {
          "id": "ratio-grid",
          "label": "A ratio, line heights on the grid",
          "creates": ["heading-lines", "label-lines", "text-lines"]
        },
        {
          "id": "ratio-proportional",
          "label": "A ratio, line heights in proportion",
          "creates": ["heading-lines", "label-lines", "text-lines"]
        },
        {
          "id": "fixed",
          "label": "Fixed steps",
          "creates": ["heading-lines", "label-lines", "text-lines"]
        }
      ]
    },
