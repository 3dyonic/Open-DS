      "id": "typography.roles",
      "method": "roles",
      "text": "Which text roles does it need?",
      "description": "The set of text roles. Each role becomes a type decision.",
      "options": [
        {
          "id": "core",
          "label": "Core: heading, body, label",
          "creates": [
            "heading-size",
            "body-size",
            "small-text-size",
            "heading-weight",
            "text-weight"
          ]
        },
        {
          "id": "core-data",
