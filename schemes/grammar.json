{
  "$schema": "../schema/grammar.schema.json",
  "id": "open-ds-grammar",
  "version": "0.1.0",
  "status": "draft",
  "description": "The Open DS grammar: a finite set of questions a design system must answer. Reasons come first (business, people, content, tasks, human factors, outcomes, brand, voice and tone, team). Scopes follow (typography to naming). Each scheme answers every question, and each answer says why and which earlier answers it follows from. Situations are the moments where people need to know what to use; each scheme answers them too. Component keys are the shared component API every scheme fills.",
  "ai": {
    "use_when": "You need the list of questions behind a design system, or the meaning of a question id such as typography.q3 or a situation id such as number-in-table.",
    "how_to_read": "Reasons are answered first. A scope answer lists in 'because' the reason answers that pulled it. Tokens follow from the answers. Components read only component keys."
  },
  "layers": [
    {
      "id": "reasons",
      "description": "Why the system exists: product, people, content, tasks, human factors, outcomes, brand, voice and tone, team."
    },
    {
      "id": "scopes",
      "description": "The design decisions: typography, color, spacing, shape, elevation, motion, iconography, theming, accessibility, naming."
    },
    {
      "id": "tokens",
      "description": "Primitives are the options. Semantics are the decisions, in light and dark. Brands and modes are themes."
    },
    {
      "id": "component-api",
      "description": "One key per component element, variant and state. Every scheme fills every key."
    }
  ],
  "reasons": [
    {
      "id": "business",
