{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3dyonic/Open-DS/harness/harness.schema.json",
  "title": "Harness source",
  "description": "A list of requirements (ticket specs) and the named checks that prove each one. Check names must exist in harness/checks.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "description", "source", "items"],
  "properties": {
    "$schema": { "type": "string", "description": "Path to this schema." },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What this list is, for a person or an agent reading it cold."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Where the requirements came from (Jira keys and dates)."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "The requirements.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "checks"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OD-\\d+$",
            "description": "The Jira key of the ticket.",
            "examples": ["OD-117"]
          },
          "title": { "type": "string", "minLength": 1, "description": "The requirement in plain words." },
          "in": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "What the ticket delivers."
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "description": "Names of checks in harness/checks.mjs. All must pass for the requirement to pass."
          }
        }
      }
    }
  }
}
