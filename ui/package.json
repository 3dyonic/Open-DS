{
  "name": "@open-ds/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Open DS components: shadcn-style React and Tailwind v4 components on Radix that read only Open DS component keys, so every scheme themes them through CSS variables.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "registry": "node scripts/build-registry.mjs",
    "test": "node scripts/build-registry.mjs && node --import tsx --test test/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "@types/node": "^22.18.6"
  }
}
