{
  "name": "open-ds",
  "displayName": "Open DS",
  "description": "Every design system is a set of answers.",
  "homepage": "https://open-ds.dev",
  "bugs": {
    "url": "https://github.com/3dyonic/Open-DS/issues",
    "email": "contact@open-ds.dev"
  },
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/3dyonic/Open-DS"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "lint": "pnpm --dir site lint",
    "typecheck": "pnpm --dir site typecheck",
    "test": "pnpm --dir tokens build && pnpm --dir cli test && pnpm --dir harness test",
    "build": "pnpm --dir site build",
    "harness": "node harness/run.mjs",
    "harness:full": "node harness/run.mjs --full",
    "e2e": "node scripts/e2e.mjs",
    "e2e:quick": "node scripts/e2e.mjs --quick",
    "test:package": "node scripts/test-package.mjs",
    "test:create": "node scripts/test-create.mjs",
    "shots": "node scripts/shots.mjs",
    "figma-kit": "node scripts/figma-kit.mjs",
    "release": "node scripts/release.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "tinypool@<2.1.2": "^2.1.2",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "minimatch@>=10.0.0 <11.0.1": "^11.0.1",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
