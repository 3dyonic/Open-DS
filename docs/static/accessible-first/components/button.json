  "button/accessibility.values": {
   "anchor": "why-accessibility-values",
   "question": "What is the smallest target?",
   "key": "accessibility.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Large",
     "why": "Large targets for tremor and touch."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Every button. Large targets help people with motor needs."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "compact",
       "text": "Large targets help people with motor needs; nothing smaller."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "large",
       "text": "The default size is already large for motor needs; a bigger one adds nothing."
      }
