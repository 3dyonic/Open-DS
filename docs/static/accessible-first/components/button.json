  "button/color.count": {
   "anchor": "why-color-count",
   "question": "How many emphasis levels do actions need?",
   "key": "color.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Two",
     "why": "Primary and secondary only; fewer choices, fewer errors."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "primary",
       "text": "The one next step on a page."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Button decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/human.q2": {
   "anchor": "why-human-q2",
   "question": "How do people recall the interface?",
   "key": "human.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "They see it fresh each time",
     "why": "Nobody remembers the interface from last time."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "secondary",
       "text": "Every other action, always with a word: alternatives, row actions, and the first step of a delete."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "ghost",
       "text": "Every action looks like a button people can find."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "disabled",
       "text": "Keep it enabled and explain on press: nobody is left out, and nobody remembers the interface from last time."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Field: responsive",
       "Toggle: default"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 4,
     "caption": "Button decisions would reopen",
     "text": "and 1 answer that follow from it: Actions and status."
    }
   ]
  },
  "button/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "A task that fails",
     "why": "A failed form can cost someone a benefit."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "secondary",
       "text": "Every other action, always with a word: alternatives, row actions, and the first step of a delete."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "The confirm of a delete, always with the verb and an icon, so color is never the only cue."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive",
       "Badge: warning",
       "Badge: danger"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Button decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/people.q2": {
   "anchor": "why-people-q2",
   "question": "What accessibility level do we commit to?",
   "key": "people.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "AAA",
     "why": "AAA where it applies; nobody is left out."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "The confirm of a delete, always with the verb and an icon, so color is never the only cue."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "focus",
       "text": "Seen by everyone: the focus ring with an offset."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "disabled",
       "text": "Keep it enabled and explain on press: nobody is left out, and nobody remembers the interface from last time."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Field: vertical",
       "Field: horizontal",
       "Input group: inline-start",
       "Input group: inline-end",
       "Input group: block-start",
       "Input group: block-end"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 3,
