  "empty/human.q1": {
   "anchor": "why-human-q1",
   "question": "What must the interface protect?",
   "key": "human.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Attention on the content",
     "why": "Attention belongs to the text."
    },
    {
     "kind": "decided",
     "title": "So Empty",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Attention belongs to the text: the invitation is in words, not a picture."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: large",
       "Field: horizontal",
       "Item: muted"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Empty decisions would reopen",
     "text": "and 8 answers that follow from it: Surface, text, action and status, Only what floats, One, and 5 more."
    }
   ]
  },
  "empty/brand.q2": {
   "anchor": "why-brand-q2",
   "question": "How visible is the brand in the interface?",
   "key": "brand.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Present",
     "why": "The brand shows in type, not in color."
    },
    {
     "kind": "decided",
     "title": "So Empty",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Attention belongs to the text: the invitation is in words, not a picture."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Empty decision would reopen",
     "text": "and 2 answers that follow from it: A reading serif, with a sans for the interface, Only when the meaning changes."
    }
   ]
  },
  "empty/iconography.definition": {
   "anchor": "why-iconography-definition",
   "question": "What icon style and stroke?",
   "key": "iconography.definition",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Outline",
     "why": "Outline icons stay quiet beside text, at a 1.5px stroke."
    },
    {
     "kind": "decided",
     "title": "So Empty",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "icon",
       "text": "A quiet outline icon in a small tile, above a warm invitation to save an article."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Icon: plain",
       "Icon: contained-tint",
       "Icon: contained-solid"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Empty decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
