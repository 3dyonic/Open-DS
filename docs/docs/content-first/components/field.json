  "field/people.q2": {
   "anchor": "why-people-q2",
   "question": "What accessibility level do we commit to?",
   "key": "people.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "AA",
     "why": "AA is the commitment for a public site."
    },
    {
     "kind": "decided",
     "title": "So Field",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "vertical",
       "text": "Newsletter and search forms: the label above."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: focus",
       "Button: disabled"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Field decision would reopen",
     "text": "and 3 answers that follow from it: A ratio, line heights in proportion, Two: color and word, AA."
    }
   ]
  },
  "field/tasks.q2": {
   "anchor": "why-tasks-q2",
   "question": "How often do people repeat actions?",
   "key": "tasks.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Rarely",
     "why": "Actions are rare: subscribe, share, save."
    },
    {
     "kind": "decided",
     "title": "So Field",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "horizontal",
       "text": "Forms are rare and short; stacking keeps the reading column."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: primary",
       "Button: large",
       "Input group: block-start",
       "Input group: block-end"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Field decision would reopen",
     "text": "and 2 answers that follow from it: Three, Only what today's screens use."
    }
   ]
  },
  "field/human.q1": {
   "anchor": "why-human-q1",
   "question": "What must the interface protect?",
   "key": "human.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Attention on the content",
     "why": "Attention belongs to the text."
    },
    {
     "kind": "decided",
     "title": "So Field",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "horizontal",
       "text": "Forms are rare and short; stacking keeps the reading column."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: large",
       "Empty: default",
       "Item: muted"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Field decision would reopen",
     "text": "and 8 answers that follow from it: Surface, text, action and status, Only what floats, One, and 5 more."
    }
   ]
  },
  "field/scenarios.q1": {
   "anchor": "why-scenarios-q1",
   "question": "Where do people use it?",
   "key": "scenarios.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Anywhere, on any device",
     "why": "Readers arrive on phones and laptops alike."
    },
    {
     "kind": "decided",
     "title": "So Field",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "responsive",
       "text": "One stacked layout reads the same on phones and laptops."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Field decision would reopen",
     "text": "and 4 answers that follow from it: Light and dark, Touch size, Two, and 1 more."
    }
   ]
  }
