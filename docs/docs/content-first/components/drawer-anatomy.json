  "drawer/card-3": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "Which text roles does it need?",
     "answer": "Core and editorial display",
     "why": "A lead and a display role open articles."
    },
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "How large is body text?",
     "answer": "Large",
     "why": "Large body text is easy on the eyes."
    },
    {
     "kind": "answer",
     "scope": "Color",
     "question": "Which color roles does it need?",
     "answer": "Surface, text, action and status",
     "why": "Reading needs few color roles."
    },
    {
     "kind": "rule",
     "situation": "paragraph or help text",
     "use": "type.body, at most 65 characters a line",
     "not": "type.caption",
     "why": "A large size and short lines make long text easy on the eyes."
    },
    {
     "kind": "rule",
     "situation": "items that belong together",
     "use": "space.gap.default",
     "not": "space.gap.tight",
     "why": "Text needs air even inside a group."
    },
