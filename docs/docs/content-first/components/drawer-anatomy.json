     "key": "header.padding",
     "value": "1.5rem",
     "byScheme": true,
     "pick": "space.24",
     "shares": []
    }
   ]
  },
  "drawer/card-4": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Room around the text helps reading."
    },
    {
     "kind": "rule",
     "situation": "the action that completes the task",
     "use": "Button primary, one per section",
     "not": "two primaries side by side",
     "why": "One clear action per section. Two primaries make the reader choose before they have read."
