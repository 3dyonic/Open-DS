 "anatomy-steps": {
  "combobox/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Iconography",
     "question": "How big are icons next to text?",
     "answer": "Match the text",
     "why": "Icons match the text size."
    },
    {
     "kind": "token",
     "semantic": "color.text.muted",
     "key": "trigger.icon.label",
     "value": "#61594D",
     "darkValue": "#A39A8B",
     "byScheme": true,
     "rule": "The quietest text.",
     "pick": "neutral.600: the quietest text that still reads, 6.9:1 on surface.default, above the 4.5:1 floor.",
     "darkPick": "neutral.400: the quietest text that still reads, 6.16:1 on surface.default, above the 4.5:1 floor.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "size.icon",
     "key": "trigger.icon.icon-size",
     "value": "1rem",
     "byScheme": true,
     "pick": "size.16",
     "shares": []
    }
   ]
  },
  "combobox/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Only what floats",
     "why": "Only menus and dialogs float."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Soft",
     "why": "Soft shadows suit warm paper."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "The dimmed page focuses the reader on the dialog."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "content.background",
     "value": "#FFFFFF",
     "darkValue": "#1F1B16",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill.",
     "darkPick": "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light.",
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 12px 32px, #1F1B1629",
     "darkValue": "0px 12px 32px, #00000080",
     "byScheme": true,
     "pick": "shadow.overlay: one soft 32px blur in a 16% warm-brown tint lifts menus and dialogs off warm paper without a hard edge.",
     "darkPick": "shadow.overlay-dark: the same soft 32px blur at 50% black, so menus and dialogs still lift off the dark page.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#E4DDD0",
     "darkValue": "#4A4339",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": "neutral.200: a quiet line that stays visible on every surface it meets (lowest 1.33:1, on surface.canvas). It decorates, so it holds no contrast minimum.",
     "darkPick": "neutral.200: a quiet line that stays visible on every surface it meets (lowest 1.76:1, on surface.default). It decorates, so it holds no contrast minimum.",
     "shares": [
      "surface.pressed",
      "disabled.border"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "content.radius",
     "value": "0.75rem",
     "byScheme": true,
     "pick": "radius.12: a 12px corner, larger than the 8px control, rounds article cards and panels so their 8px options nest inside.",
     "shares": []
    }
   ]
  },
  "combobox/card-3": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "Which text roles does it need?",
     "answer": "Core and editorial display",
     "why": "A lead and a display role open articles."
    },
    {
     "kind": "rule",
     "situation": "items that belong together",
     "use": "space.gap.default",
     "not": "space.gap.tight",
     "why": "Text needs air even inside a group."
    },
    {
     "kind": "token",
     "semantic": "color.text.muted",
     "key": "label.label",
     "value": "#61594D",
     "darkValue": "#A39A8B",
     "byScheme": true,
     "rule": "The quietest text.",
     "pick": "neutral.600: the quietest text that still reads, 6.9:1 on surface.default, above the 4.5:1 floor.",
     "darkPick": "neutral.400: the quietest text that still reads, 6.16:1 on surface.default, above the 4.5:1 floor.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "type.caption.font-size",
     "key": "label.font-size",
     "value": "0.875rem",
     "byScheme": true,
     "pick": "font.size.14",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "component-spacing-map.x2",
     "key": "label.padding-x",
     "value": "0.5rem",
     "byScheme": false,
     "pick": "space.8",
     "shares": []
    }
   ]
  },
  "combobox/card-4": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "How large is body text?",
     "answer": "Large",
     "why": "Large body text is easy on the eyes."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Room around the text helps reading."
    },
    {
     "kind": "rule",
     "situation": "the smallest clickable thing",
     "use": "size.control.default (touch)",
     "not": "a compact control",
     "why": "Many readers are on phones."
    },
    {
     "kind": "token",
     "semantic": "type.body.font-size",
     "key": "item.font-size",
     "value": "1.125rem",
     "byScheme": true,
     "pick": "font.size.18",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "component-spacing-map.x2",
     "key": "item.padding-y",
     "value": "0.5rem",
     "byScheme": false,
     "pick": "space.8",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "component-spacing-map.x2",
     "key": "item.padding-left",
     "value": "0.5rem",
     "byScheme": false,
     "pick": "space.8",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "size.icon",
     "key": "icon-size",
     "value": "1rem",
     "byScheme": true,
     "pick": "size.16",
     "shares": []
    }
   ]
  },
  "combobox/card-5": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "Which states get their own visible value?",
     "answer": "Those and pressed",
     "why": "Pressed gets its own value for touch."
    },
    {
     "kind": "rule",
     "situation": "hover and press feedback",
     "use": "motion.duration.feedback (moderate)",
     "not": "a fast flash",
     "why": "Moderate speed feels calm in a slow reading flow. A fast flash feels jumpy."
    },
    {
     "kind": "rule",
     "situation": "keyboard focus",
     "use": "button/focus-ring at border-width.focus",
     "not": "removing the outline",
     "why": "Keyboard users must always see where they are."
    },
    {
     "kind": "token",
     "semantic": "color.surface.highlight",
     "key": "item.background.highlight",
     "value": "#F6F2EA",
     "darkValue": "#2E2A24",
     "byScheme": true,
     "rule": "The fill of the item the pointer or the keyboard is on, or whose submenu is open. A state shows on the item's background, one step from the surface it sits on: darker in light, lighter in dark.",
     "pick": "neutral.100, two steps darker than the surfaces it sits on (neutral.0), so the item under the pointer or the keyboard reads as a band without lifting off the page. It skips neutral.50, the page canvas, so a menu item never matches the page behind it.",
     "darkPick": "neutral.100, one step lighter than the surfaces it sits on (neutral.50), so the item under the pointer or the keyboard reads as a band on the menu and on cards.",
     "shares": [
      "surface.sunken",
      "action.secondary.hover",
      "category.5.subtle",
      "disabled.surface"
     ]
    }
   ]
  },
  "combobox/card-6": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded corners feel friendly."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Room around the text helps reading."
    },
    {
     "kind": "rule",
     "situation": "shape of a status badge",
     "use": "radius.badge (pill)",
     "not": "a rectangle",
     "why": "Pills sit softly next to text."
    },
    {
     "kind": "token",
     "semantic": "color.border.strong",
     "key": "chips.border",
     "value": "#7A7062",
     "darkValue": "#A39A8B",
     "byScheme": true,
     "rule": "The edge of a control people must find.",
     "pick": "neutral.500: the edge of a control people must find, 4.86:1 on surface.default, above the 3:1 floor.",
     "darkPick": "neutral.400: the edge of a control people must find, 6.16:1 on surface.default, above the 3:1 floor.",
     "shares": [
      "category.5",
      "disabled.text"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.element",
     "key": "chips.radius",
     "value": "0.5rem",
     "byScheme": true,
     "pick": "radius.8: the control corner; it is not a pill, so a growing box keeps it.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.surface.sunken",
     "key": "chip.background",
     "value": "#F6F2EA",
     "darkValue": "#2E2A24",
     "byScheme": true,
     "rule": "A recessed fill, a step below content.",
     "pick": "neutral.100, a step below content (1.12:1 on surface.default), so table headers and wells read as recessed.",
     "darkPick": "neutral.100, a step below content (1.2:1 on surface.default), so table headers and wells read as recessed.",
     "shares": [
