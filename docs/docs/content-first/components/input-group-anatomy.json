     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded corners feel friendly."
    },
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "What is the smallest target?",
     "answer": "Touch size",
     "why": "Readers are often on phones."
    },
