  "dropdown-menu/card-6": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "How many signals carry each meaning?",
     "answer": "Two: color and word",
     "why": "Status is rare; color and a word are enough."
    },
    {
     "kind": "rule",
     "situation": "delete or remove",
     "use": "Button secondary with the full verb, then confirm with Button danger",
     "not": "button primary",
     "why": "Naming the verb and confirming prevents a mistake."
    },
    {
     "kind": "token",
     "semantic": "color.status.danger",
     "key": "item.label.destructive",
     "value": "#C42B2B",
     "darkValue": "#F28B8B",
     "byScheme": true,
     "rule": "Real risk: errors, failed checks, actions that cannot be undone. The top of the urgency order. Overuse wears it out.",
