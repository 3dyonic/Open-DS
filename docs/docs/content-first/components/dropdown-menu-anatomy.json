 "anatomy-steps": {
  "dropdown-menu/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Only what floats",
     "why": "Only menus and dialogs float."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Soft",
     "why": "Soft shadows suit warm paper."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "The dimmed page focuses the reader on the dialog."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "overlay.background",
     "value": "#FFFFFF",
     "darkValue": "#1F1B16",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill."
     ],
     "darkPick": [
      "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "overlay.shadow",
     "value": "0px 12px 32px, #1F1B1629",
     "darkValue": "0px 12px 32px, #00000080",
     "byScheme": true,
     "pick": [
      "shadow.overlay: Soft shadows suit warm paper."
     ],
     "darkPick": [
      "shadow.overlay-dark: Soft shadows suit warm paper."
     ],
     "shares": []
    }
   ]
  },
  "dropdown-menu/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "How large is body text?",
     "answer": "Large",
     "why": "Large body text is easy on the eyes."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Room around the text helps reading."
    },
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "What is the smallest target?",
     "answer": "Touch size",
     "why": "Readers are often on phones."
    },
    {
     "kind": "rule",
     "situation": "the smallest clickable thing",
     "use": "size.control.default (touch)",
     "not": "a compact control",
     "why": "Many readers are on phones."
    },
    {
     "kind": "token",
     "semantic": "type.body.font-size",
     "key": "item.font-size",
     "value": "1.125rem",
     "byScheme": true,
     "pick": [
      "font.size.18"
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "space.inset.cell-x",
     "key": "item.padding-x",
     "value": "1rem",
     "byScheme": true,
     "pick": [
      "space.16"
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "size.control.default",
     "key": "overlay.item-height",
     "value": "3rem",
     "byScheme": true,
     "pick": [
      "size.48"
     ],
     "shares": []
    }
   ]
  },
  "dropdown-menu/card-3": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "Which states get their own visible value?",
     "answer": "Those and pressed",
     "why": "Pressed gets its own value for touch."
    },
    {
     "kind": "answer",
     "scope": "Motion",
     "question": "How fast does feedback feel?",
     "answer": "Moderate",
     "why": "Moderate speed feels calm."
    },
    {
     "kind": "rule",
     "situation": "hover and press feedback",
     "use": "motion.duration.feedback (moderate)",
     "not": "a fast flash",
     "why": "Moderate speed feels calm in a slow reading flow. A fast flash feels jumpy."
    },
    {
     "kind": "token",
     "semantic": "color.surface.highlight",
     "key": "item.background.highlight",
     "value": "#F6F2EA",
     "darkValue": "#2E2A24",
     "byScheme": true,
     "rule": "The fill of the item the pointer or the keyboard is on, or whose submenu is open. A state shows on the item's background, one step from the surface it sits on: darker in light, lighter in dark.",
     "pick": [
      "neutral.100, two steps darker than the surfaces it sits on (neutral.0), so the item under the pointer or the keyboard reads as a band without lifting off the page. It skips neutral.50, the page canvas, so a menu item never matches the page behind it."
     ],
     "darkPick": [
      "neutral.100, one step lighter than the surfaces it sits on (neutral.50), so the item under the pointer or the keyboard reads as a band on the menu and on cards."
     ],
     "shares": [
      "surface.sunken",
      "action.secondary.hover",
      "category.5.subtle",
      "disabled.surface"
     ]
    }
   ]
  },
