   "anchor": "why-tasks-q2",
   "question": "How often do people repeat actions?",
   "key": "tasks.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Rarely",
     "why": "Actions are rare: subscribe, share, save."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "primary",
       "text": "One clear action per section."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "large",
       "text": "Attention belongs to the text: one clear action per section, at the normal size."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Field: horizontal",
       "Input group: block-start",
       "Input group: block-end"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Button decisions would reopen",
     "text": "and 2 answers that follow from it: Three, Only what today's screens use."
    }
   ]
  },
