 "anatomy-steps": {
  "sheet/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Only what floats",
     "why": "Only menus and dialogs float."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Soft",
     "why": "Soft shadows suit warm paper."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "The dimmed page focuses the reader on the dialog."
    },
    {
     "kind": "token",
     "semantic": "color.surface.scrim",
     "key": "overlay.background",
     "value": "#0000008C",
     "darkValue": "#000000B3",
     "byScheme": false,
     "rule": "The see-through layer behind a modal.",
     "pick": [
      "black.light.scrim: a see-through layer that dims the page behind a modal, so the dialog is the one thing to act on."
     ],
     "darkPick": [
      "black.dark.scrim: a see-through layer that dims the page behind a modal, so the dialog is the one thing to act on."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.surface.canvas",
     "key": "content.background",
     "value": "#FFFDF8",
     "darkValue": "#14110D",
     "byScheme": true,
     "rule": "The page background behind everything.",
     "pick": [
      "neutral.50, under content: ",
      {
       "ratio": 1.02
      },
      " from surface.default, so cards and panels stand forward."
     ],
     "darkPick": [
      "neutral.0, under content: ",
      {
       "ratio": 1.1
      },
      " from surface.default, so cards and panels stand forward."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 12px 32px, #1F1B1629",
     "darkValue": "0px 12px 32px, #00000080",
     "byScheme": true,
     "pick": [
      "shadow.overlay: We use step 2 of the shadow scale for menus and dialogs in order to show their height as floating layers. The cast shade does this by a 12px offset and a 32px blur in a 16% warm brown. So a menu lifts off warm paper without a hard edge, because only what floats rises (elevation.roles) and shadows are soft (elevation.values)."
     ],
     "darkPick": [
      "shadow.overlay-dark: We use the light shadow's shape for menus and dialogs in dark in order to show the same floating height by the dark-shade relation. The cast shade does this by the same 12px offset and 32px blur, at 50% black instead of 16% brown. So a menu still lifts off the dark page, though its shade reads weaker on dark than in light, because only what floats rises (elevation.roles) and dark ships for night reading (theming.values)."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#E4DDD0",
     "darkValue": "#4A4339",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.33
      },
      ", on surface.canvas). It decorates, so it holds no contrast minimum."
     ],
     "darkPick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.46
      },
      ", on surface.raised). It decorates, so it holds no contrast minimum."
     ],
     "shares": [
      "surface.pressed",
      "border.raised",
      "disabled.border"
     ]
    }
   ]
  },
