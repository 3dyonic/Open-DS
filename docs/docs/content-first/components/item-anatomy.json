     "kind": "answer",
     "scope": "Iconography",
     "question": "How big are icons next to text?",
     "answer": "Match the text",
     "why": "Icons match the text size."
    },
    {
     "kind": "rule",
     "situation": "corners of buttons and inputs",
     "use": "radius.control (rounded)",
     "not": "sharp corners",
     "why": "Rounded corners match the warm reading tone. Sharp corners feel technical next to long text."
    },
    {
     "kind": "token",
     "semantic": "size.control.default",
     "key": "media.icon.size",
     "value": "3rem",
