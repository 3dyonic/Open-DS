     "key": "media.icon.background",
     "value": "#F6F2EA",
     "darkValue": "#14110D",
     "byScheme": true,
     "rule": "A recessed fill, a step below content.",
     "pick": "neutral.100, a step below content (1.12:1 on surface.default), so table headers and wells read as recessed.",
     "darkPick": "neutral.0: We use one step darker than content for table headers and wells in dark, in order to show depth by tone, 1.1:1 on surface.default. The darker fill does this by the depth rule turned downward: what sits lower is darker. So a well reads as recessed and never as a raised card, because dark ships as standard (theming.values) and depth reads from tone and lines (elevation.definition).",
     "shares": [
      "surface.highlight",
      "action.secondary.hover",
      "category.5.subtle",
      "disabled.surface"
     ]
    },
