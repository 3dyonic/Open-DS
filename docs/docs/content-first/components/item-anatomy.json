  "item/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Room around the text helps reading."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded corners feel friendly."
    },
    {
     "kind": "rule",
     "situation": "items that belong together",
     "use": "space.gap.default",
     "not": "space.gap.tight",
     "why": "Text needs air even inside a group."
    },
    {
     "kind": "token",
     "semantic": "space.inset.container",
     "key": "default.padding",
     "value": "1.5rem",
     "byScheme": true,
     "pick": "space.24",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "space.gap.group",
     "key": "default.gap",
     "value": "2rem",
     "byScheme": true,
     "pick": "space.32",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "radius.element",
     "key": "radius",
     "value": "0.5rem",
     "byScheme": true,
     "pick": "radius.8: We use the 8px control corner for boxes that grow in order to keep their role, as objects of one family, by inheritance from the control corner. The same radius does this by giving a list item or a text area the curve of the controls beside it. So fields and rows read as one family, because the control corner is rounded, not a pill (shape.values), and the brand is warm (brand.q1).",
     "shares": []
    }
   ]
  },
  "item/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded corners feel friendly."
    },
