     "byScheme": true,
     "pick": "source-serif-4 for heading text: Source Serif 4 for reading and headings, Inter for labels and captions: a good magazine's text with a quiet interface.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "type.heading.font-size",
