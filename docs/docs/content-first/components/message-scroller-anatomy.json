 "anatomy-steps": {
  "message-scroller/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "Which shape roles does it need?",
     "answer": "Controls, badges and containers",
     "why": "Pill badges differ from controls."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded corners feel friendly."
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "0.75rem",
     "byScheme": true,
     "pick": "radius.12: We use a 12px corner for article cards, menus and dialogs in order to make each card read as a separate object, in a warm tone by brand convention. A larger radius does this by breaking the outline with a curve wider than the 8px controls inside it. So a card reads as one calm object on the page, because containers get their own corner (shape.roles, shape.count) and the brand is warm (brand.q1).",
     "shares": []
    }
   ]
  },
  "message-scroller/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "Which spacing roles does it need?",
     "answer": "Gaps and insets",
     "why": "No dense tables, so no row role."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Room around the text helps reading."
    },
    {
     "kind": "rule",
     "situation": "items that belong together",
     "use": "space.gap.default",
     "not": "space.gap.tight",
     "why": "Text needs air even inside a group."
    },
    {
     "kind": "token",
     "semantic": "space.gap.group",
     "key": "gap",
     "value": "2rem",
     "byScheme": true,
     "pick": "space.32",
     "shares": []
    }
   ]
  },
  "message-scroller/card-3": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "Which states get their own visible value?",
     "answer": "Those and pressed",
     "why": "Pressed gets its own value for touch."
    },
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "What contrast floor do we hold?",
     "answer": "AA",
     "why": "AA contrast, with large text helping further."
    },
    {
     "kind": "rule",
     "situation": "keyboard focus",
     "use": "button/focus-ring at border-width.focus",
     "not": "removing the outline",
     "why": "Keyboard users must always see where they are."
    },
    {
     "kind": "token",
     "semantic": "border-width.focus",
     "key": "focus",
     "value": "2px",
     "byScheme": true,
     "pick": "border-width.2",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.focus",
     "key": "focus-ring-focus",
     "value": "#1E3A5F",
     "darkValue": "#8FA6C4",
     "byScheme": true,
     "rule": "The focus ring.",
     "pick": "navy.light.600: the focus ring, so the keyboard's place is never lost, 11.5:1 on surface.default, above the 3:1 floor.",
     "darkPick": "navy.dark.600: the focus ring, so the keyboard's place is never lost, 6.86:1 on surface.default, above the 3:1 floor.",
     "shares": [
      "border.selected",
      "action.primary",
      "category.1"
     ]
    },
    {
     "kind": "token",
