 "reason-chain": {
  "badge/accessibility.count": {
   "anchor": "why-accessibility-count",
   "question": "How many signals carry each meaning?",
   "key": "accessibility.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Two: color and word",
     "why": "Status is rare; color and a word are enough."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "neutral",
       "text": "Saved: waiting for you; nothing is wrong."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "info",
       "text": "Topics and reading states need no news tone; status is rare."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "success",
       "text": "Finished: you read it to the end."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "warning",
       "text": "Out of date: the facts may have changed since it was written."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "danger",
       "text": "Nothing in an article fails; errors are calm sentences, not labels."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 5,
     "caption": "Badge decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "badge/voice.count": {
   "anchor": "why-voice-count",
   "question": "How many tones does it use?",
   "key": "voice.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "One per moment",
     "why": "Warm by default, calmer for errors."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "danger",
       "text": "Nothing in an article fails; errors are calm sentences, not labels."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive",
       "Toast: danger"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  }
 },
