       "why": "Many readers are on phones."
      },
      {
       "kind": "use",
       "situation": "Most buttons and inputs",
       "why": "Readers on phones get a full touch target on every control."
      },
      {
       "kind": "not",
       "situation": "A button inside a field",
       "detail": "use size.control.compact",
       "why": "A clear or show button must fit inside the field around it."
