 "anatomy-steps": {
  "message-scroller/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "Which shape roles does it need?",
     "answer": "Controls and containers",
     "why": "Pills everywhere; badges share the control corner."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Pill",
     "why": "Pill controls feel playful."
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "1.5rem",
     "byScheme": true,
     "pick": "radius.24: We use a 24px corner for cards, menus and dialogs in order to make each offer read as a separate object, in a bold tone by brand convention. A large radius does this by breaking the outline with a wide curve while the sides stay straight. So each offer reads as one friendly object, because containers get their own corner (shape.count) and the brand is bold (brand.q1).",
     "shares": []
    }
   ]
  },
  "message-scroller/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "Which spacing roles does it need?",
     "answer": "Gaps and insets",
     "why": "Few tables; no row role needed."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Big space makes big moments."
    },
    {
     "kind": "rule",
     "situation": "items that belong together",
     "use": "space.gap.default",
     "not": "space.gap.tight",
     "why": "Air keeps big type readable."
