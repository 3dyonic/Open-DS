 "anatomy-steps": {
  "popover/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Cards too",
     "why": "Cards lift to feel like objects."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Pronounced",
     "why": "Pronounced shadows add depth."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Pill",
     "why": "Pill controls feel playful."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "Strong depth shows a menu or dialog sits above vivid sections. Without a shadow it blends into the color blocks."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "content.background",
     "value": "#FFFFFF",
     "darkValue": "#1F1411",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill.",
     "darkPick": "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light.",
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "content.radius",
     "value": "1.5rem",
     "byScheme": true,
     "pick": "radius.24: Cards, menus and dialogs take a big, round 24px corner, so a card feels like a friendly object and keeps its box shape.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#F2DCCF",
     "darkValue": "#4D3A33",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": "neutral.200: a quiet line that stays visible on every surface it meets (lowest 1.26:1, on surface.canvas). It decorates, so it holds no contrast minimum.",
     "darkPick": "neutral.200: a quiet line that stays visible on every surface it meets (lowest 1.69:1, on surface.default). It decorates, so it holds no contrast minimum.",
     "shares": [
      "surface.pressed",
      "disabled.border"
     ]
    },
    {
     "kind": "token",
     "semantic": "border-width.default",
     "key": "content.border-width",
     "value": "2px",
     "byScheme": true,
     "pick": "border-width.2",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 24px 48px, #1F141133",
     "darkValue": "0px 24px 48px, #00000099",
     "byScheme": true,
     "pick": "shadow.overlay: Menus and dialogs lift on a 24px offset with a 48px blur, twice the card's, so they sit clearly above vivid sections.",
     "darkPick": "shadow.overlay-dark: Menus and dialogs lift on a 24px offset with a 48px blur in deeper black, twice the card's, so they sit above dark sections.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "space.inset.container",
     "key": "content.padding",
     "value": "2rem",
     "byScheme": true,
     "pick": "space.32",
     "shares": []
    }
   ]
  },
