       "subject": "outline",
       "text": "A pill with a border, so the toggle reads as a control on vivid color."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Toggle decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "toggle/accessibility.values": {
   "anchor": "why-accessibility-values",
   "question": "What is the smallest target?",
   "key": "accessibility.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Touch size",
     "why": "Visitors come from social posts on phones."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Every toggle, at touch size: phones first."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "sm",
       "text": "Phones first: no compact controls."
      }
     ],
     "also": {
