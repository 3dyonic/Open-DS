     "text": "and 1 answer that follow from it: Those and pressed."
    }
   ]
  },
  "toggle/tasks.q2": {
   "anchor": "why-tasks-q2",
   "question": "How often do people repeat actions?",
   "key": "tasks.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Rarely",
     "why": "One action: sign up."
