 "reason-chain": {
  "toggle/components.roles": {
   "anchor": "why-components-roles",
   "question": "Which component families does it need?",
   "key": "components.roles",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Core, plus media",
     "why": "Campaigns lead with media and big sections."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Sections lead with media and color blocks, not toolbars; a toggle with no border is lost on vivid color."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Toggle decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "toggle/color.values": {
   "anchor": "why-color-values",
   "question": "How saturated is the palette?",
   "key": "color.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Vivid",
     "why": "Vivid color is the brand."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Sections lead with media and color blocks, not toolbars; a toggle with no border is lost on vivid color."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "outline",
       "text": "A pill with a border, so the toggle reads as a control on vivid color."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Item: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Toggle decisions would reopen",
     "text": "and 2 answers that follow from it: Contained, Brand color."
    }
   ]
  },
  "toggle/shape.values": {
   "anchor": "why-shape-values",
