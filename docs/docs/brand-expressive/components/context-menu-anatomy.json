 "anatomy-steps": {
  "context-menu/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Cards too",
     "why": "Cards lift to feel like objects."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Pronounced",
     "why": "Pronounced shadows add depth."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "Strong depth shows a menu or dialog sits above vivid sections. Without a shadow it blends into the color blocks."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "content.background",
     "value": "#FFFFFF",
     "darkValue": "#1F1411",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill.",
     "darkPick": "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light.",
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 24px 48px, #1F141133",
     "darkValue": "0px 24px 48px, #00000099",
     "byScheme": true,
     "pick": "shadow.overlay: Pronounced shadows add depth.",
     "darkPick": "shadow.overlay-dark: Pronounced shadows add depth.",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#F2DCCF",
     "darkValue": "#4D3A33",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": "neutral.200: a quiet line that stays visible on every surface it meets (lowest 1.26:1, on surface.canvas). It decorates, so it holds no contrast minimum.",
     "darkPick": "neutral.200: a quiet line that stays visible on every surface it meets (lowest 1.69:1, on surface.default). It decorates, so it holds no contrast minimum.",
     "shares": [
      "surface.pressed",
      "disabled.border"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "content.radius",
     "value": "1.5rem",
     "byScheme": true,
     "pick": "radius.24: Pill controls feel playful.",
     "shares": []
    }
   ]
  },
  "context-menu/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "How large is body text?",
     "answer": "Regular",
     "why": "Regular body; the display does the shouting."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Spacious",
     "why": "Big space makes big moments."
    },
    {
     "kind": "answer",
     "scope": "Iconography",
     "question": "How big are icons next to text?",
     "answer": "Larger than the text",
     "why": "Larger icons hold their own next to big type."
    },
    {
     "kind": "rule",
     "situation": "the smallest clickable thing",
     "use": "size.control.default (touch)",
     "not": "a compact control",
     "why": "Most visitors arrive on phones, and a compact control is too small for a thumb."
    },
    {
     "kind": "token",
     "semantic": "type.body.font-size",
     "key": "item.font-size",
     "value": "1.0625rem",
