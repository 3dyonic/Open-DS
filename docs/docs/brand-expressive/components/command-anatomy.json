  "command/card-5": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "Which states get their own visible value?",
     "answer": "Those and pressed",
     "why": "Pressed for touch."
    },
    {
     "kind": "rule",
     "situation": "hover and press feedback",
     "use": "motion.duration.feedback (fast)",
     "not": "an instant change",
     "why": "Fast feedback on an ease-out. The brand's spring waits for the moments that deserve it."
    },
    {
     "kind": "rule",
     "situation": "keyboard focus",
     "use": "button/focus-ring at focus.ring.width",
     "not": "removing the outline",
     "why": "Focus must show on vivid color."
    },
    {
     "kind": "token",
     "semantic": "color.surface.highlight",
     "key": "item.background.highlight",
     "value": "#FCEFE6",
     "darkValue": "#090403",
     "byScheme": true,
     "rule": "The fill of the item the pointer or the keyboard is on, or whose submenu is open. A state shows on the item's background, one step from the surfaces it sits on: darker in light, and darker in dark too, as raised layers take the lighter step.",
     "pick": [
      "neutral.100, two steps darker than the surfaces it sits on (neutral.0), so the item under the pointer or the keyboard reads as a band without lifting off the page. It skips neutral.50, the page canvas, so a menu item never matches the page behind it."
     ],
     "darkPick": [
      "neutral.floor: We use the floor step, below the canvas, for the item under the pointer or the keyboard in dark, in order to mark it as a band on both surfaces it meets: ",
      {
       "ratio": 1.13
      },
      " on surface.default and ",
      {
       "ratio": 1.37
      },
      " on surface.raised, and ",
      {
       "ratio": 1.05
      },
      " off the page. The fill does this by stepping darker, as raised layers took the lighter step; muted text still reads ",
      {
       "ratio": 7.59
      },
      " on it. So the hovered row or menu item shows on cards and menus alike, because hover and focus have their own look (accessibility.roles) and the neutral ramp sets the steps (color.definition)."
     ],
     "shares": [
      "surface.sunken",
      "action.secondary.hover",
      "category.5.subtle",
      "disabled.surface"
     ]
    }
   ]
