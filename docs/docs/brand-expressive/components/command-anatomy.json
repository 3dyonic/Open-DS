 "anatomy-steps": {
  "command/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Pill",
     "why": "Pill controls feel playful."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Cards too",
     "why": "Cards lift to feel like objects."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "Strong depth shows a menu or dialog sits above vivid sections. Without a shadow it blends into the color blocks."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "background",
     "value": "#FFFFFF",
     "darkValue": "#33241F",
     "byScheme": true,
     "rule": "Fills that float above content. In dark, one step lighter than content, so height reads by tone.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill."
     ],
     "darkPick": [
      "neutral.100: We use one step lighter than content for menus, dialogs and raised cards in dark, in order to show height by tone, ",
      {
       "ratio": 1.21
      },
      " on surface.default. The lighter fill does this by the dark-mode depth rule: the higher a layer sits, the lighter its surface. So visitors see a menu above the page even where its shadow barely shows, because dark ships as standard (theming.values) and the roles answer names the layers that rise (elevation.roles)."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "1.5rem",
     "byScheme": true,
     "pick": [
      "radius.24: We use a 24px corner for cards, menus and dialogs in order to make each offer read as a separate object, in a bold tone by brand convention. A large radius does this by breaking the outline with a wide curve while the sides stay straight. So each offer reads as one friendly object, because containers get their own corner (shape.count) and the brand is bold (brand.q1)."
     ],
     "shares": []
    }
   ]
  },
