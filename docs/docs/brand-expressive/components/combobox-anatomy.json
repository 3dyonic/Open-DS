 "anatomy-steps": {
  "combobox/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Iconography",
     "question": "How big are icons next to text?",
     "answer": "Larger than the text",
     "why": "Larger icons hold their own next to big type."
    },
    {
     "kind": "token",
     "semantic": "color.text.muted",
     "key": "trigger.icon.label",
     "value": "#6B544A",
     "darkValue": "#B5988A",
     "byScheme": true,
     "rule": "The quietest text.",
     "pick": [
      "neutral.600: the quietest text that still reads, ",
      {
       "ratio": 7.02
      },
      " on surface.default, above the ",
      {
       "ratio": 4.5
      },
      " floor."
     ],
     "darkPick": [
      "neutral.400: the quietest text that still reads, ",
      {
       "ratio": 6.71
      },
      " on surface.default, above the ",
      {
       "ratio": 4.5
      },
      " floor."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "size.icon",
     "key": "trigger.icon.icon-size",
     "value": "1.25rem",
     "byScheme": true,
     "pick": [
      "size.20"
     ],
     "shares": []
    }
   ]
  },
  "combobox/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Cards too",
     "why": "Cards lift to feel like objects."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Pronounced",
     "why": "Pronounced shadows add depth."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "Strong depth shows a menu or dialog sits above vivid sections. Without a shadow it blends into the color blocks."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "content.background",
     "value": "#FFFFFF",
     "darkValue": "#1F1411",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill."
     ],
     "darkPick": [
      "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 24px 48px, #1F141133",
     "darkValue": "0px 24px 48px, #00000099",
     "byScheme": true,
     "pick": [
      "shadow.overlay: We use step 2 of the shadow scale for menus and dialogs in order to show floating height, one step above the cards. The cast shade does this by a 24px offset and a 48px blur at 20%, larger than the card's. So a menu sits clearly above vivid sections and cards, because cards and overlays rise (elevation.roles) and shadows are pronounced (elevation.values)."
     ],
     "darkPick": [
      "shadow.overlay-dark: We use the light overlay shadow's shape in dark in order to show the same floating height by the dark-shade relation. The cast shade does this by the same 24px offset and 48px blur, at 60% black instead of 20%. So a menu still sits above dark sections, though its shade reads weaker on dark than in light, because cards and overlays rise (elevation.roles) and dark ships as standard (theming.values)."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#F2DCCF",
     "darkValue": "#4D3A33",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.26
      },
      ", on surface.canvas). It decorates, so it holds no contrast minimum."
     ],
     "darkPick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.69
      },
      ", on surface.default). It decorates, so it holds no contrast minimum."
     ],
     "shares": [
      "surface.pressed",
      "disabled.border"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "content.radius",
     "value": "1.5rem",
     "byScheme": true,
     "pick": [
      "radius.24: We use a 24px corner for cards, menus and dialogs in order to make each offer read as a separate object, in a bold tone by brand convention. A large radius does this by breaking the outline with a wide curve while the sides stay straight. So each offer reads as one friendly object, because containers get their own corner (shape.count) and the brand is bold (brand.q1)."
     ],
     "shares": []
    }
   ]
  },
