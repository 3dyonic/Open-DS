  "item/elevation.definition": {
   "anchor": "why-elevation-definition",
   "question": "What separates groups on the page?",
   "key": "elevation.definition",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Cards",
     "why": "Cards hold each offer."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Rows inside a card, which already gives the frame."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Item decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "item/color.values": {
   "anchor": "why-color-values",
   "question": "How saturated is the palette?",
   "key": "color.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Vivid",
     "why": "Vivid color is the brand."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "outline",
       "text": "Rows on a color block, with a border so each holds its edge on vivid color."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Toggle: default",
       "Toggle: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Item decision would reopen",
     "text": "and 2 answers that follow from it: Contained, Brand color."
    }
   ]
  },
  "item/brand.q2": {
   "anchor": "why-brand-q2",
   "question": "How visible is the brand in the interface?",
   "key": "brand.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Loud",
     "why": "The brand is loud everywhere."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "muted",
       "text": "A quiet fill reads as bland on a loud page; color blocks already mark each section."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Item decisions would reopen",
     "text": "and 23 answers that follow from it: A display face for brand moments, with a sans for text, Core and expressive display, Fine steps, so pages can set their own rhythm, and 20 more."
    }
   ]
  },
  "item/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Looking off-brand",
     "why": "A bland page is the costly mistake."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "muted",
       "text": "A quiet fill reads as bland on a loud page; color blocks already mark each section."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: secondary",
       "Button: danger",
       "Alert: destructive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Item decision would reopen",
     "text": "and 1 answer that follow from it: One per moment."
    }
   ]
  },
  "item/accessibility.values": {
   "anchor": "why-accessibility-values",
   "question": "What is the smallest target?",
   "key": "accessibility.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Touch size",
     "why": "Visitors come from social posts on phones."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Every row, at touch size: phones first."
