     "answer": "Two: color and word",
     "why": "Color and word."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "neutral",
       "text": "New: a label, not a state to fix."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "success",
       "text": "On the list: you joined and your place is saved."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "warning",
       "text": "Almost gone: few left, act soon."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 3,
     "caption": "Badge decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "badge/content.q1": {
   "anchor": "why-content-q1",
   "question": "What is the main content?",
   "key": "content.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Images and campaigns",
     "why": "Images, campaigns and short punchy copy."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "info",
       "text": "Campaign labels are a state or a nudge; there are no plain news labels."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Empty: default",
       "Input group: block-start",
       "Input group: block-end"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "and 11 answers that follow from it: One idea at a time, Browse and explore, A display face for brand moments, with a sans for text, and 8 more."
    }
   ]
  },
  "badge/outcomes.q1": {
   "anchor": "why-outcomes-q1",
   "question": "Which outcome matters most?",
   "key": "outcomes.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Engagement",
     "why": "Engagement and sign-ups."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "warning",
       "text": "Almost gone: few left, act soon."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: primary",
       "Button: large",
       "Toast: success",
       "Toggle: lg"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "and 6 answers that follow from it: A few minutes, Brand moments, Hero and launch moments, and 3 more."
    }
   ]
  },
  "badge/voice.count": {
   "anchor": "why-voice-count",
   "question": "How many tones does it use?",
   "key": "voice.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "One per moment",
     "why": "Playful in headlines, plain in errors."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "danger",
