     "rules": [
      {
       "kind": "use",
       "situation": "Corners of buttons and inputs",
       "detail": "radius.control (pill)",
       "why": "Pills match the brand's round, playful shapes. Sharp corners would feel corporate."
      },
      {
       "kind": "not",
       "situation": "An option in a menu or list",
       "detail": "use radius.option",
       "why": "Round options nest inside the round menu, so a menu feels as playful as the buttons."
      },
      {
       "kind": "not",
       "situation": "Something that grows past one line",
       "detail": "use radius.element",
       "why": "A pill corner breaks when a text area grows to many lines. The element corner stays round at any height."
