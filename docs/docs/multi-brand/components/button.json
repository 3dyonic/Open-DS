 "reason-chain": {
  "button/outcomes.q1": {
   "anchor": "why-outcomes-q1",
   "question": "Which outcome matters most?",
   "key": "outcomes.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Completion without errors",
     "why": "Finished sign-ups and orders."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "primary",
       "text": "One clear action per view."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "large",
       "text": "One clear action per view, at the normal size, in every brand."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: default"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Button decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/color.count": {
   "anchor": "why-color-count",
   "question": "How many emphasis levels do actions need?",
   "key": "color.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Three",
     "why": "Primary, secondary and ghost in every brand."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "secondary",
       "text": "The alternative that steps back, and the first step of a delete."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Button decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Looking off-brand",
     "why": "A page that looks like the wrong brand loses trust."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "secondary",
       "text": "The alternative that steps back, and the first step of a delete."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "The confirm of a delete, the same red in every brand: danger never follows the brand."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Badge: danger",
       "Alert: destructive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Button decisions would reopen",
     "text": "and 1 answer that follow from it: Also for emphasis and size."
    }
   ]
  },
  "button/human.q2": {
   "anchor": "why-human-q2",
   "question": "How do people recall the interface?",
   "key": "human.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "They see it fresh each time",
     "why": "Customers see it fresh each time."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "ghost",
       "text": "Row actions, with a word."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Toggle: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Button decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/accessibility.values": {
   "anchor": "why-accessibility-values",
   "question": "What is the smallest target?",
   "key": "accessibility.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Touch size",
     "why": "Customers sign up on phones."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Every button, at touch size: customers are often on phones."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "compact",
       "text": "Customers are often on phones: no compact controls."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "icon",
       "text": "Customers use any device and hover hints never show on touch, so every button has a word."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Field: horizontal",
       "Item: default",
       "Item: sm",
       "Toggle: default",
       "Toggle: sm"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 3,
     "caption": "Button decisions would reopen",
     "text": "and 1 answer that follow from it: Those and pressed."
    }
   ]
  },
  "button/iconography.roles": {
   "anchor": "why-iconography-roles",
   "question": "What do icons do?",
   "key": "iconography.roles",
   "steps": [
