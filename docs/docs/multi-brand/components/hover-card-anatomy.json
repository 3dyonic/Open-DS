 "anatomy-steps": {
  "hover-card/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Cards too",
     "why": "Cards lift slightly to group offers."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Soft",
     "why": "Soft shadows fit every brand."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded by default; each brand sets its own corner."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "The shadow shows a menu or dialog floats above the page. Without it, it blends into the cards."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "content.background",
     "value": "#FFFFFF",
     "darkValue": "#0F172A",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill."
     ],
     "darkPick": [
      "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "content.radius",
     "value": "0.5rem",
     "byScheme": true,
     "pick": [
      "radius.8: Aster's cards and dialogs take 8px, twice the 4px control corner, so a 4px option nests inside with 4px padding."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#E2E8F0",
     "darkValue": "#334155",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.18
      },
      ", on surface.canvas). It decorates, so it holds no contrast minimum."
     ],
     "darkPick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.72
      },
      ", on surface.default). It decorates, so it holds no contrast minimum."
     ],
     "shares": [
      "surface.pressed",
      "disabled.border"
     ]
    },
    {
     "kind": "token",
     "semantic": "border-width.default",
     "key": "content.border-width",
     "value": "1px",
     "byScheme": true,
     "pick": [
      "border-width.1"
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 12px 32px, #0F172A29",
     "darkValue": "0px 12px 32px, #00000080",
     "byScheme": true,
     "pick": [
      "shadow.overlay: a soft 32px blur at a 12px offset, four times the card's blur, so a menu or dialog floats clear above the cards."
     ],
     "darkPick": [
      "shadow.overlay-dark: the same 32px blur and 12px offset in 50% black, so a menu or dialog still floats above cards on a dark page."
     ],
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "space.inset.container",
     "key": "content.padding",
     "value": "1.5rem",
     "byScheme": true,
     "pick": [
      "space.24"
     ],
     "shares": []
    }
   ]
  },
