   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "A shared core, brand tone on top",
     "why": "Errors and confirmations are shared; brand tone sits on top."
    },
    {
     "kind": "decided",
     "title": "So Empty",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Shared structure in every brand: no brand pictures in empty states."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive",
       "Toast: neutral",
       "Toast: danger"
      ]
