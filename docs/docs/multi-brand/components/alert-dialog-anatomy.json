     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded by default; each brand sets its own corner."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "The shadow shows a menu or dialog floats above the page. Without it, it blends into the cards."
    },
    {
     "kind": "token",
     "semantic": "color.surface.scrim",
     "key": "overlay.background",
     "value": "#0000008C",
     "darkValue": "#000000B3",
     "byScheme": false,
     "rule": "The see-through layer behind a modal.",
     "pick": "black.light.scrim: a see-through layer that dims the page behind a modal, so the dialog is the one thing to act on.",
     "darkPick": "black.dark.scrim: a see-through layer that dims the page behind a modal, so the dialog is the one thing to act on.",
     "shares": []
    },
    {
     "kind": "token",
