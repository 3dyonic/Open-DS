     "value": "#C42B2B",
     "darkValue": "#F28B8B",
     "byScheme": true,
     "rule": "Real risk: errors, failed checks, actions that cannot be undone. The top of the urgency order. Overuse wears it out.",
     "pick": "red.light.600: danger reads as text and icons, 5.63:1 on surface.default, above the 4.5:1 floor.",
     "darkPick": "red.dark.600: danger reads as text and icons, 7.52:1 on surface.default, above the 4.5:1 floor.",
     "shares": [
      "action.danger"
     ]
    }
   ]
  },
  "dropdown-menu/card-7": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What separates groups on the page?",
     "answer": "Cards",
     "why": "Cards group plans and offers."
    },
    {
     "kind": "rule",
     "situation": "between page sections",
     "use": "space.gap.section and cards",
     "not": "lines",
     "why": "Cards hold each offer together, so customers compare offers as units in every brand. Lines would split an offer apart."
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
