  "dropdown-menu/card-6": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "How many signals carry each meaning?",
     "answer": "Two: color and word",
     "why": "Brand colors vary, so meaning needs a word."
    },
    {
     "kind": "rule",
     "situation": "delete or remove",
     "use": "Button secondary, then confirm with Button danger",
     "not": "button primary",
     "why": "Confirm before destroying data."
    },
