  "command/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Rounded",
     "why": "Rounded by default; each brand sets its own corner."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Cards too",
     "why": "Cards lift slightly to group offers."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page",
     "not": "no shadow",
     "why": "The shadow shows a menu or dialog floats above the page. Without it, it blends into the cards."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "background",
     "value": "#FFFFFF",
     "darkValue": "#0F172A",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill."
     ],
     "darkPick": [
      "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "0.5rem",
     "byScheme": true,
     "pick": [
      "radius.8: Rounded by default; each brand sets its own corner."
     ],
     "shares": []
    }
   ]
