    {
     "kind": "decided",
     "title": "So Field",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "vertical",
       "text": "Sign-up and checkout forms: the label above, in every brand."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "responsive",
       "text": "Account settings: stacked on phones, label beside on laptops."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
