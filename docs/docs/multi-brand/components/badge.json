  "badge/accessibility.count": {
   "anchor": "why-accessibility-count",
   "question": "How many signals carry each meaning?",
   "key": "accessibility.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Two: color and word",
     "why": "Brand colors vary, so meaning needs a word."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "neutral",
       "text": "Trial: the plan works and billing has not started."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "info",
       "text": "Renews in 3 days: a payment is coming; nothing has gone wrong."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "success",
       "text": "Active: the plan is paid and running."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "warning",
       "text": "No plan or order state sits between running and failed; a coming renewal is news, not a warning."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "Card declined: the payment failed, so the plan will stop."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 5,
     "caption": "Badge decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "badge/content.q1": {
   "anchor": "why-content-q1",
   "question": "What is the main content?",
   "key": "content.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Forms and tasks",
     "why": "Product pages, sign-up and account forms."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "warning",
       "text": "No plan or order state sits between running and failed; a coming renewal is news, not a warning."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: default",
       "Input group: inline-start",
       "Input group: inline-end",
       "Input group: block-start",
       "Input group: block-end",
       "Item: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "and 9 answers that follow from it: A moderate amount, Gaps, insets and row heights, Comfortable, and 6 more."
    }
   ]
  },
  "badge/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Looking off-brand",
     "why": "A page that looks like the wrong brand loses trust."
    },
    {
     "kind": "decided",
     "title": "So Badge",
