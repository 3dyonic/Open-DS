   "anchor": "why-components-definition",
   "question": "How does a component earn its place?",
   "key": "components.definition",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Its family is in the roles, so product teams find it ready",
     "why": "Product teams find a whole family ready instead of asking one by one."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Toggles that sit together, like monthly or yearly prices, use toggle-group."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Toggle decision would reopen",
     "text": "No other answer follows from it."
