 "reason-chain": {
  "item/content.q1": {
   "anchor": "why-content-q1",
   "question": "What is the main content?",
   "key": "content.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Numbers and records",
     "why": "Most of the screen is numbers and records."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Users and settings in a panel or menu, with no border, quiet beside the data."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "outline",
       "text": "Borders on every row would compete with the data; hairlines between sections do that work."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Badge: neutral",
       "Badge: info",
       "Badge: success",
       "Badge: warning",
       "Badge: danger",
       "Sidebar: default",
       "Sidebar: outline",
       "Empty: default",
       "Toggle: default",
       "Toggle: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 5,
     "caption": "Item decisions would reopen",
     "text": "and 45 answers that follow from it: A lot, Scan and compare, People keep their place, and 42 more."
    }
   ]
  },
  "item/elevation.definition": {
   "anchor": "why-elevation-definition",
   "question": "What separates groups on the page?",
   "key": "elevation.definition",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Lines",
     "why": "Thin lines guide the eye along rows."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "outline",
       "text": "Borders on every row would compete with the data; hairlines between sections do that work."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Item decision would reopen",
     "text": "and 3 answers that follow from it: Only what floats, One, Menus and dialogs."
    }
   ]
  },
  "item/tasks.q1": {
   "anchor": "why-tasks-q1",
