  "toggle/content.q1": {
   "anchor": "why-content-q1",
   "question": "What is the main content?",
   "key": "content.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Numbers and records",
     "why": "Most of the screen is numbers and records."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "In the table toolbar, with no border; the pressed state shows as a fill, quiet beside the data."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "outline",
       "text": "Borders on every toggle would compete with the data."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Badge: neutral",
       "Badge: info",
       "Badge: success",
       "Badge: warning",
       "Badge: danger",
       "Sidebar: default",
       "Sidebar: outline",
       "Empty: default",
       "Item: default",
       "Item: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 5,
     "caption": "Toggle decisions would reopen",
     "text": "and 45 answers that follow from it: A lot, Scan and compare, People keep their place, and 42 more."
    }
   ]
  },
