  "toggle/content.q2": {
   "anchor": "why-content-q2",
   "question": "How much is on one screen?",
   "key": "content.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "A lot",
     "why": "Experts want many records on one screen."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Toggles sit in the table toolbar, at the smaller size like compact buttons."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "sm",
       "text": "The table toolbar, matching compact buttons. It still fits a mouse."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "lg",
       "text": "Controls stay small so more records fit on one screen."
