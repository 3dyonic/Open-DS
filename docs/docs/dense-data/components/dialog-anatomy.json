    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Compact",
     "why": "Compact spacing shows more records."
    },
    {
     "kind": "rule",
     "situation": "the action that completes the task",
     "use": "Button primary, one per view",
     "not": "two primaries side by side",
     "why": "One primary makes the committing action obvious."
    },
    {
     "kind": "rule",
     "situation": "an alternative or cancel",
     "use": "Button secondary",
     "not": "button ghost",
     "why": "A ghost button has no edge, so next to a filled primary it reads as plain text and cancel gets lost. Secondary keeps a visible border, so people find it at once."
    },
    {
     "kind": "rule",
     "situation": "delete or remove",
     "use": "Button secondary, then confirm in a dialog with Button danger",
     "not": "button primary as the first step",
     "why": "Deleting is rare and costly; a confirm step catches mistakes."
    },
