  "drawer/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Only what floats",
     "why": "Only menus and dialogs float; cards use lines."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "Subtle",
     "why": "Subtle shadows keep the grid crisp."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Slightly rounded",
     "why": "Small corners keep dense rows straight."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page for dialogs",
     "not": "a border only",
     "why": "Floating things need a shadow so they read as on top."
    },
    {
     "kind": "token",
