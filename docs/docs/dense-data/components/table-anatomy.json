 "anatomy-steps": {
  "table/card-1": {
   "steps": [
    {
     "kind": "answer",
     "question": "What is the main content?",
     "answer": "Numbers and records",
     "why": "Most of the screen is numbers and records."
    },
    {
     "kind": "answer",
     "scope": "Typography",
     "question": "Which text roles does it need?",
     "answer": "Core and data",
     "why": "A data role keeps numbers in aligned columns."
    },
    {
     "kind": "rule",
     "situation": "field label or column header",
     "use": "type.label",
     "not": "type.heading",
     "why": "Headers repeat on every column; a heavy style would compete with the data."
    },
    {
     "kind": "token",
     "semantic": "color.surface.sunken",
     "key": "header-background",
     "value": "#EEF1F5",
     "darkValue": "#06090E",
     "byScheme": true,
     "rule": "A recessed fill, a step below content.",
     "pick": [
      "neutral.100, a step below content (",
      {
       "ratio": 1.13
      },
      " on surface.default), so table headers and wells read as recessed."
     ],
     "darkPick": [
      "neutral.floor: We use the floor step, below the page's canvas, for table headers and wells in dark, in order to show depth by tone, ",
      {
       "ratio": 1.15
      },
      " under content and ",
      {
       "ratio": 1.05
      },
      " under the canvas. The darker fill does this by the depth rule turned downward: what sits lower is darker. So a well reads as recessed and never as a raised card, because dark ships as standard (theming.values) and depth reads from tone and lines (elevation.definition)."
     ],
     "shares": [
      "surface.highlight",
      "surface.pressed",
      "action.secondary.hover",
      "category.5.subtle",
      "disabled.surface"
     ]
    },
    {
     "kind": "token",
     "semantic": "color.text.secondary",
     "key": "head.label",
     "value": "#3D4655",
     "darkValue": "#C4CBD6",
     "byScheme": true,
     "rule": "Supporting text.",
     "pick": [
      "neutral.700: supporting text, ",
      {
       "ratio": 9.52
      },
      " on surface.default, above the ",
      {
       "ratio": 4.5
      },
      " floor."
     ],
     "darkPick": [
      "neutral.500: supporting text, ",
      {
       "ratio": 10.58
      },
      " on surface.default, above the ",
      {
       "ratio": 4.5
      },
      " floor."
     ],
     "shares": []
    },
    {
