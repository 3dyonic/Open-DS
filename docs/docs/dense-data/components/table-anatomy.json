  "table/card-2": {
   "steps": [
    {
     "kind": "answer",
     "question": "How much is on one screen?",
     "answer": "A lot",
     "why": "Experts want many records on one screen."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Compact",
     "why": "Compact spacing shows more records."
    },
