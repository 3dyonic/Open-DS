     "use": "size.row (compact)",
     "not": "the comfortable row",
     "why": "Compact rows show more records without scrolling."
    },
    {
     "kind": "rule",
     "situation": "a number in a table",
     "use": "type.data",
     "not": "type.body",
     "why": "Mono digits line up in columns, so values compare at a glance."
