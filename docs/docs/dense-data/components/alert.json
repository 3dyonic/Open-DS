  "alert/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Acting on the wrong record",
     "why": "Acting on the wrong row is the costly error."
    },
    {
     "kind": "decided",
     "title": "So Alert",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Alerts here are for problems that stay on the page; news goes in a toast or a badge."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "destructive",
       "text": "A record that was not saved or an action that failed: name the record, then the fix, with an icon."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: primary",
       "Button: secondary",
       "Button: danger",
       "Toast: danger"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Alert decisions would reopen",
     "text": "and 2 answers that follow from it: Status in tables, Errors and empty states."
    }
   ]
  },
  "alert/tasks.q2": {
   "anchor": "why-tasks-q2",
   "question": "How often do people repeat actions?",
   "key": "tasks.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Constantly",
     "why": "The same actions repeat many times an hour."
    },
    {
     "kind": "decided",
     "title": "So Alert",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Alerts here are for problems that stay on the page; news goes in a toast or a badge."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: ghost",
       "Input group: inline-end",
       "Sidebar: default",
       "Toast: success",
       "Toggle: default"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Alert decision would reopen",
     "text": "and 11 answers that follow from it: Time on task, All day, Three, and 8 more."
    }
   ]
  },
  "alert/accessibility.count": {
   "anchor": "why-accessibility-count",
   "question": "How many signals carry each meaning?",
   "key": "accessibility.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Three: color, icon and word",
     "why": "Many statuses share one table; color alone is not enough."
    },
    {
     "kind": "decided",
     "title": "So Alert",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "destructive",
       "text": "A record that was not saved or an action that failed: name the record, then the fix, with an icon."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Badge: neutral",
       "Badge: info",
       "Badge: success",
       "Badge: warning",
       "Badge: danger"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Alert decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "alert/voice.values": {
   "anchor": "why-voice-values",
   "question": "How does it sound?",
   "key": "voice.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Terse",
     "why": "Experts want short labels and short messages."
    },
    {
     "kind": "decided",
     "title": "So Alert",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "destructive",
       "text": "A record that was not saved or an action that failed: name the record, then the fix, with an icon."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
