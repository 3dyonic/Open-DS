      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "large",
       "text": "Controls stay small so more records fit on one screen."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Input group: block-start",
       "Input group: block-end",
       "Field: horizontal",
       "Sidebar: lg",
       "Toggle: default",
       "Toggle: sm",
       "Toggle: lg"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 3,
     "caption": "Button decisions would reopen",
     "text": "and 15 answers that follow from it: Quiet, A neutral grotesque, with a monospace for data, Only the steps the screens need, and 12 more."
    }
   ]
  },
