 "reason-chain": {
  "button/color.count": {
   "anchor": "why-color-count",
   "question": "How many emphasis levels do actions need?",
   "key": "color.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Three",
     "why": "One primary per view; the rest step back."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "primary",
       "text": "The one commit in a view."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Button decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Acting on the wrong record",
     "why": "Acting on the wrong row is the costly error."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "primary",
       "text": "The one commit in a view."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "secondary",
       "text": "Alternatives and cancel next to the primary, and the first step of a delete."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "The confirm of a bulk delete. Many records go at once, so the last press must not look like the everyday primary."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: default",
       "Alert: destructive",
       "Toast: danger"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 3,
     "caption": "Button decisions would reopen",
     "text": "and 2 answers that follow from it: Status in tables, Errors and empty states."
    }
   ]
  },
  "button/human.q2": {
   "anchor": "why-human-q2",
   "question": "How do people recall the interface?",
   "key": "human.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "They learn it and recognize it",
     "why": "Daily users learn the interface and recognize it."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "secondary",
       "text": "Alternatives and cancel next to the primary, and the first step of a delete."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "ghost",
       "text": "Row actions, as compact icon buttons. Never for cancel."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Button decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "button/tasks.q2": {
   "anchor": "why-tasks-q2",
   "question": "How often do people repeat actions?",
   "key": "tasks.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Constantly",
     "why": "The same actions repeat many times an hour."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "ghost",
       "text": "Row actions, as compact icon buttons. Never for cancel."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Input group: inline-end",
       "Sidebar: default",
       "Alert: default",
       "Toast: success",
       "Toggle: default"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 4,
     "caption": "Button decisions would reopen",
     "text": "and 11 answers that follow from it: Time on task, All day, Three, and 8 more."
    }
   ]
  },
  "button/content.q2": {
   "anchor": "why-content-q2",
   "question": "How much is on one screen?",
   "key": "content.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "A lot",
     "why": "Experts want many records on one screen."
    },
    {
     "kind": "decided",
     "title": "So Button",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Actions outside tables: forms, dialogs, page actions."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "compact",
