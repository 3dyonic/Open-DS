 "anatomy-steps": {
  "message-scroller/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "Which shape roles does it need?",
     "answer": "Controls, badges and containers",
     "why": "Badges sit in columns and need their own corner."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Slightly rounded",
     "why": "Small corners keep dense rows straight."
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "0.25rem",
     "byScheme": true,
     "pick": "radius.4: We use a 4px corner for cards, menus and dialogs in order to make touching panels read as separate objects, in a precise tone by brand convention. A small radius does this by breaking the outline at each corner, just softer than the 2px controls. So panels read apart yet still tile neatly, because containers get their own corner (shape.roles, shape.count) and the brand is precise (brand.q1).",
     "shares": []
    }
   ]
  },
  "message-scroller/card-2": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "Which spacing roles does it need?",
     "answer": "Gaps, insets and row heights",
     "why": "Row height is a decision of its own in a table product."
    },
    {
     "kind": "answer",
     "scope": "Spacing",
     "question": "How dense is the layout?",
     "answer": "Compact",
     "why": "Compact spacing shows more records."
    },
    {
     "kind": "rule",
     "situation": "items that belong together",
     "use": "space.gap.tight",
     "not": "space.gap.group",
     "why": "Things that belong together sit close."
    },
    {
     "kind": "token",
     "semantic": "space.gap.group",
     "key": "gap",
     "value": "1rem",
     "byScheme": true,
     "pick": "space.16",
     "shares": []
    }
   ]
  },
  "message-scroller/card-3": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "Which states get their own visible value?",
     "answer": "Hover, focus, disabled",
     "why": "Pressed reuses hover; experts do not need more."
    },
    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "What contrast floor do we hold?",
     "answer": "AA",
     "why": "AA contrast for every text."
    },
    {
     "kind": "rule",
     "situation": "keyboard focus",
     "use": "button/focus-ring at focus.ring.width",
     "not": "removing the outline",
     "why": "Keyboard users must always see where they are."
    },
    {
     "kind": "token",
     "semantic": "focus.ring.width",
     "key": "focus",
     "value": "2px",
     "byScheme": true,
     "pick": "border-width.2",
     "shares": []
    },
    {
     "kind": "token",
     "semantic": "color.border.focus",
     "key": "focus-ring-focus",
     "value": "#4B3FD9",
     "darkValue": "#A9A3F6",
     "byScheme": true,
     "rule": "The focus ring.",
     "pick": "violet.light.600: the focus ring, so the keyboard's place is never lost, 6.97:1 on surface.default, above the 3:1 floor.",
     "darkPick": "violet.dark.600: the focus ring, so the keyboard's place is never lost, 7.62:1 on surface.default, above the 3:1 floor.",
     "shares": [
      "border.selected",
