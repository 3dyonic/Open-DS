    {
     "kind": "answer",
     "scope": "Accessibility",
     "question": "Which states get their own visible value?",
     "answer": "Hover, focus, disabled",
     "why": "Pressed reuses hover; experts do not need more."
    },
    {
     "kind": "rule",
     "situation": "hover and press feedback",
     "use": "motion.duration.feedback (fast)",
     "not": "no transition",
     "why": "Fast feedback confirms the pointer without slowing experts."
    },
    {
     "kind": "rule",
     "situation": "keyboard focus",
     "use": "button/focus-ring at border-width.focus",
     "not": "removing the outline",
     "why": "Keyboard users must always see where they are."
    },
    {
     "kind": "token",
