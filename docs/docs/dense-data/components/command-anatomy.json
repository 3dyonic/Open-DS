 "anatomy-steps": {
  "command/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Slightly rounded",
     "why": "Small corners keep dense rows straight."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Only what floats",
     "why": "Only menus and dialogs float; cards use lines."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "elevation.overlay and a dimmed page for dialogs",
     "not": "a border only",
     "why": "Floating things need a shadow so they read as on top."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "background",
     "value": "#FFFFFF",
     "darkValue": "#161B23",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill."
     ],
     "darkPick": [
      "neutral.50, the same as content (surface.default): a menu stands out by its edge and its one shadow, not by its fill, as in light."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "0.25rem",
     "byScheme": true,
     "pick": [
      "radius.4: Small corners keep dense rows straight."
     ],
     "shares": []
    }
   ]
  },
