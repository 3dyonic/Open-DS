 "reason-chain": {
  "toggle/human.q2": {
   "anchor": "why-human-q2",
   "question": "How do people recall the interface?",
   "key": "human.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "They see it fresh each time",
     "why": "Nobody remembers the interface from last time."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Every action looks like a control people can find, so the toggle keeps its border."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: secondary",
       "Button: ghost",
       "Button: disabled",
       "Field: responsive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Toggle decisions would reopen",
     "text": "and 1 answer that follow from it: Actions and status."
    }
   ]
  },
  "toggle/elevation.definition": {
   "anchor": "why-elevation-definition",
   "question": "What separates groups on the page?",
   "key": "elevation.definition",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Lines",
     "why": "Strong borders separate groups at any zoom."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "Every action looks like a control people can find, so the toggle keeps its border."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "outline",
       "text": "Every toggle, with a strong border and a word, so it reads as a control at any zoom."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Item: default",
       "Item: outline"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Toggle decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "toggle/iconography.roles": {
   "anchor": "why-iconography-roles",
   "question": "What do icons do?",
   "key": "iconography.roles",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Actions and status",
     "why": "Icons support words; they never replace them."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "outline",
       "text": "Every toggle, with a strong border and a word, so it reads as a control at any zoom."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: icon",
       "Input group: inline-end"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Toggle decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "toggle/accessibility.values": {
   "anchor": "why-accessibility-values",
   "question": "What is the smallest target?",
   "key": "accessibility.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Large",
     "why": "Large targets for tremor and touch."
    },
    {
     "kind": "decided",
     "title": "So Toggle",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "default",
       "text": "Every toggle. Large targets help people with motor needs."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "sm",
       "text": "Large targets help people with motor needs; nothing smaller."
      },
      {
       "used": false,
       "verb": "does not use",
       "subject": "lg",
       "text": "The default size is already large for motor needs; a bigger one adds nothing."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: default",
       "Button: compact",
       "Button: large",
       "Item: default",
       "Item: sm"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 3,
     "caption": "Toggle decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  }
 },
