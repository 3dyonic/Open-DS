 "anatomy-steps": {
  "context-menu/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Nothing",
     "why": "Flat is easier to read at high zoom."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "How soft are shadows?",
     "answer": "No shadows",
     "why": "No shadows; borders do the work."
    },
    {
     "kind": "rule",
     "situation": "a menu or dialog",
     "use": "A strong border and a dimmed page",
     "not": "a shadow only",
     "why": "The dimmed page makes the dialog obvious."
    },
    {
     "kind": "token",
     "semantic": "color.surface.raised",
     "key": "content.background",
     "value": "#FFFFFF",
     "darkValue": "#141414",
     "byScheme": true,
     "rule": "Fills that float above content.",
     "pick": [
      "neutral.0, the same as content (surface.default): a menu stands out by its edge alone, not by its fill."
     ],
     "darkPick": [
      "neutral.50, the same as content (surface.default): a menu stands out by its edge alone, not by its fill, as in light."
     ],
     "shares": [
      "surface.default",
      "action.secondary"
     ]
    },
    {
     "kind": "token",
     "semantic": "elevation.overlay",
     "key": "content.shadow",
     "value": "0px 0px 0px, #00000000",
     "byScheme": true,
     "pick": [
      "shadow.none: No shadows; borders do the work."
     ],
     "shares": [
      "elevation.card"
     ]
    },
    {
     "kind": "token",
     "semantic": "color.border.default",
     "key": "content.border",
     "value": "#D6D6D6",
     "darkValue": "#333333",
     "byScheme": true,
     "rule": "Quiet edges and dividers. Decorative, so it has no contrast minimum.",
     "pick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.36
      },
      ", on surface.canvas). It decorates, so it holds no contrast minimum."
     ],
     "darkPick": [
      "neutral.200: a quiet line that stays visible on every surface it meets (lowest ",
      {
       "ratio": 1.46
      },
      ", on surface.default). It decorates, so it holds no contrast minimum."
     ],
     "shares": [
      "surface.pressed",
      "disabled.border"
     ]
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "content.radius",
     "value": "0.5rem",
     "byScheme": true,
     "pick": [
      "radius.8: Clear, slightly rounded controls."
