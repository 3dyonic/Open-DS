 "anatomy-steps": {
  "card/card-1": {
   "steps": [
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What rises above the page?",
     "answer": "Nothing",
     "why": "Flat is easier to read at high zoom."
    },
    {
     "kind": "answer",
     "scope": "Elevation",
     "question": "What separates groups on the page?",
     "answer": "Lines",
     "why": "Strong borders separate groups at any zoom."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Slightly rounded",
     "why": "Clear, slightly rounded controls."
    },
    {
     "kind": "rule",
     "situation": "a card on the page",
     "use": "A strong border, no shadow",
     "not": "a shadow",
     "why": "Shadows are hard to see; borders are not."
    },
    {
     "kind": "token",
     "semantic": "color.surface.default",
     "key": "background",
     "value": "#FFFFFF",
     "darkValue": "#141414",
     "byScheme": true,
     "rule": "The base fill for content.",
     "pick": "neutral.0: the base for content; body text reads 18.42:1 on it, above the 7:1 floor.",
     "darkPick": "neutral.50: the base for content; body text reads 17.2:1 on it, above the 7:1 floor.",
     "shares": [
