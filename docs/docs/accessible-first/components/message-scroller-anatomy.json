    {
     "kind": "answer",
     "scope": "Shape",
     "question": "Which shape roles does it need?",
     "answer": "Controls, badges and containers",
     "why": "Badges keep a clear rectangle."
    },
    {
     "kind": "answer",
     "scope": "Shape",
     "question": "What should control corners say?",
     "answer": "Slightly rounded",
     "why": "Clear, slightly rounded controls."
    },
    {
     "kind": "token",
     "semantic": "radius.surface",
     "key": "radius",
     "value": "0.5rem",
     "byScheme": true,
     "pick": "radius.8: Cards, menus and dialogs take the largest corner, 8px, so a container's corner differs from the 6px controls inside it.",
     "shares": []
    }
   ]
