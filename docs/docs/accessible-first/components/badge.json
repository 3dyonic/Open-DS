 "reason-chain": {
  "badge/accessibility.count": {
   "anchor": "why-accessibility-count",
   "question": "How many signals carry each meaning?",
   "key": "accessibility.count",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Three: color, icon and word",
     "why": "Never color alone."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "neutral",
       "text": "A waiting state, such as an application saved to resume later, with an icon and a word."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "success",
       "text": "A finished task, with a filled icon and a word."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "warning",
       "text": "A risk people can still fix before they finish, with an icon and a word."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "A failure that blocks the task, with a filled icon and a word; an alert says how to fix it."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: destructive",
       "Item: muted"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 4,
     "caption": "Badge decisions would reopen",
     "text": "and 1 answer that follow from it: Status and messages."
    }
   ]
  },
  "badge/scenarios.q2": {
   "anchor": "why-scenarios-q2",
   "question": "How long is one visit?",
   "key": "scenarios.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "One sitting",
     "why": "An application is finished in one sitting, or saved and resumed."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "neutral",
       "text": "A waiting state, such as an application saved to resume later, with an icon and a word."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "badge/components.values": {
   "anchor": "why-components-values",
   "question": "When does a component get another look?",
   "key": "components.values",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Only when the meaning changes",
     "why": "One clear way to do each thing."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "info",
       "text": "Neutral covers news with nothing to do: one clear way to do each thing."
      }
     ]
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "No other answer follows from it."
    }
   ]
  },
  "badge/outcomes.q1": {
   "anchor": "why-outcomes-q1",
   "question": "Which outcome matters most?",
   "key": "outcomes.q1",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Completion without errors",
     "why": "Completion without errors is the measure."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "success",
       "text": "A finished task, with a filled icon and a word."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Alert: default"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 1,
     "caption": "Badge decision would reopen",
     "text": "and 3 answers that follow from it: Links and actions, Form steps and errors, Neutrals and one brand ramp."
    }
   ]
  },
  "badge/outcomes.q2": {
   "anchor": "why-outcomes-q2",
   "question": "What is a costly mistake?",
   "key": "outcomes.q2",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "A task that fails",
     "why": "A failed form can cost someone a benefit."
    },
    {
     "kind": "decided",
     "title": "So Badge",
     "lines": [
      {
       "used": true,
       "verb": "uses",
       "subject": "warning",
       "text": "A risk people can still fix before they finish, with an icon and a word."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "danger",
       "text": "A failure that blocks the task, with a filled icon and a word; an alert says how to fix it."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Button: secondary",
       "Button: danger",
       "Alert: destructive"
      ]
     }
    },
    {
     "kind": "change",
     "title": "If it changed",
     "count": 2,
     "caption": "Badge decisions would reopen",
     "text": "No other answer follows from it."
    }
   ]
  }
