  "item/elevation.definition": {
   "anchor": "why-elevation-definition",
   "question": "What separates groups on the page?",
   "key": "elevation.definition",
   "steps": [
    {
     "kind": "answer",
     "title": "The answer",
     "answer": "Lines",
     "why": "Strong borders separate groups at any zoom."
    },
    {
     "kind": "decided",
     "title": "So Item",
     "lines": [
      {
       "used": false,
       "verb": "does not use",
       "subject": "default",
       "text": "A row with no border is hard to see at high zoom; borders do the work."
      },
      {
       "used": true,
       "verb": "uses",
       "subject": "outline",
       "text": "Each saved application, with a strong border that separates it at any zoom."
      }
     ],
     "also": {
      "label": "It also shapes",
      "items": [
       "Toggle: default",
       "Toggle: outline"
      ]
     }
