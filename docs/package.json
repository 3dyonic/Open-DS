{
  "name": "@open-ds/docs",
  "version": "0.1.0",
  "private": true,
  "description": "The docs of every Open DS scheme (Docusaurus), each as the design system it builds: reasons, voice and tone, foundations per scope, components, themes and agent layer. A switcher in the top bar swaps the scheme and keeps the page.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "pnpm --dir ../tokens build && node scripts/generate.mjs",
    "start": "pnpm run generate && docusaurus start",
    "build": "pnpm run generate && docusaurus build",
    "serve": "docusaurus serve",
    "test": "pnpm run generate && node scripts/generate.mjs --check",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.0",
    "@open-ds/doc-composites": "workspace:*",
    "@open-ds/ui": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
