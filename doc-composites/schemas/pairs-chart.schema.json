{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ds.dev/schemas/doc-composites/pairs-chart.schema.json",
  "title": "Pairs chart",
  "description": "Which text may sit on which fill in one brand of a scheme, and the contrast each pair keeps, in each mode. Drawn by the PairsChart composite on Foundations › Color.",
  "type": "object",
  "required": ["modes"],
  "additionalProperties": false,
  "properties": {
    "modes": {
      "type": "array",
      "description": "The pairs in each mode, light first.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mode", "page", "groups"],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["light", "dark"],
            "description": "The mode."
          },
          "page": {
            "type": "object",
            "description": "The page colors of this mode, as hex values.",
            "required": ["canvas", "text", "muted", "edge"],
            "additionalProperties": false,
            "properties": {
              "canvas": {
                "type": "string",
                "description": "color.surface.canvas."
              },
              "text": {
                "type": "string",
                "description": "color.text.primary."
              },
              "muted": { "type": "string", "description": "color.text.muted." },
              "edge": {
                "type": "string",
                "description": "color.border.default."
              }
            }
          },
          "groups": {
            "type": "array",
            "description": "The fills, grouped by their tone in this mode: the page's own surfaces, light fills, dark fills.",
            "items": {
              "type": "object",
              "required": ["title", "note", "fills"],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "description": "The group's name."
                },
                "note": {
                  "type": "string",
                  "description": "Which text the group's fills take, in a sentence."
                },
                "fills": {
                  "type": "array",
                  "description": "Each fill in the group.",
                  "items": {
                    "type": "object",
                    "required": ["fill", "primitive", "hex", "pairs"],
                    "additionalProperties": false,
                    "properties": {
                      "fill": {
                        "type": "string",
                        "description": "The fill token, without color., such as surface.default."
                      },
                      "primitive": {
                        "type": "string",
                        "description": "The primitive the fill ends at."
                      },
                      "hex": {
                        "type": "string",
                        "description": "The fill's value."
                      },
                      "pairs": {
                        "type": "array",
                        "description": "Every text token that may sit on this fill.",
                        "items": {
                          "type": "object",
                          "required": [
                            "text",
                            "primitive",
                            "hex",
                            "contrast",
                            "floor"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "text": {
                              "type": "string",
                              "description": "The text token, without color., such as text.primary."
                            },
                            "primitive": {
                              "type": "string",
                              "description": "The primitive the text ends at."
                            },
                            "hex": {
                              "type": "string",
                              "description": "The text's value."
                            },
                            "contrast": {
                              "type": "number",
                              "description": "The WCAG contrast of the text on the fill, to two decimals."
                            },
                            "floor": {
                              "type": "number",
                              "description": "The least contrast the scheme requires for this pair."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
