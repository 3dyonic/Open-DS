{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ds.dev/schemas/doc-composites/scale-options.schema.json",
  "title": "Scale options",
  "description": "The same key color built with other answers to color.definition.steps, each as a whole light scale. Drawn by the ScaleOptions composite on How the scale is built.",
  "type": "object",
  "required": [
    "hue",
    "key",
    "options"
  ],
  "additionalProperties": false,
  "properties": {
    "hue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The hue of the key scale, such as pink or blue."
    },
    "key": {
      "type": "string",
      "const": "600",
      "description": "The key step: the key color sits exact here."
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "description": "Each answer, least eased first.",
      "items": {
        "type": "object",
        "required": [
          "option",
          "label",
          "easing",
          "own",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "option": {
            "type": "string",
            "enum": [
              "linear",
              "light-ease",
              "medium-ease",
              "even-ease",
              "strong-ease"
            ],
            "description": "The option's id."
          },
          "label": {
            "type": "string",
            "description": "The option's label, from the grammar."
          },
          "description": {
            "type": "string",
            "description": "The option's description, from the grammar."
          },
          "easing": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The option's easing strength."
          },
          "own": {
            "type": "boolean",
            "description": "True for the scheme's own answer."
          },
          "steps": {
            "type": "array",
            "description": "The key built with this option, before any hold, lightest first.",
            "minItems": 11,
            "maxItems": 11,
            "items": {
              "type": "object",
              "required": [
                "step",
                "hex"
              ],
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "string",
                  "pattern": "^(50|[1-9]00|950)$",
                  "description": "The step of the scale, 50 to 950."
                },
                "hex": {
                  "type": "string",
                  "pattern": "^#[0-9A-F]{6}$",
                  "description": "The color as built, in uppercase hex."
                }
              }
            }
          }
        }
      }
    }
  }
}
