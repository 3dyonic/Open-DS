{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ds.dev/schemas/doc-composites/fill-tones.schema.json",
  "title": "Fill tones",
  "description": "Each fill of one brand and its tone, light or dark, in each mode; the tone picks the text on the fill. Drawn by the FillTones composite on Foundations › Color.",
  "type": "object",
  "required": [
    "modes",
    "fills"
  ],
  "additionalProperties": false,
  "properties": {
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "light",
          "dark"
        ]
      },
      "description": "The modes, in column order."
    },
    "fills": {
      "type": "array",
      "minItems": 1,
      "description": "Each fill, in the grammar's order.",
      "items": {
        "type": "object",
        "required": [
          "fill",
          "tones"
        ],
        "additionalProperties": false,
        "properties": {
          "fill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9@_-]+)+$",
            "description": "The fill token's full name, such as color.surface.canvas."
          },
          "tones": {
            "type": "array",
            "description": "The fill's tone in each mode, in the order of modes.",
            "items": {
              "type": "object",
              "required": [
                "mode",
                "tone"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ],
                  "description": "The mode."
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ],
                  "description": "Whether the fill is light or dark in this mode."
                },
                "primitive": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9@_-]+)+$",
                  "description": "The primitive the fill ends at in this mode, such as color.violet.light.100."
                },
                "via": {
                  "type": "string",
                  "pattern": "^color\\.neutral\\.[0-9]+$",
                  "description": "The neutral step the fill goes through in this mode, such as color.neutral.50. Absent when the fill points at its primitive directly."
                },
                "waits": {
                  "type": "string",
                  "description": "The answer the tone waits for, when the scheme has not answered it yet."
                }
              }
            }
          }
        }
      }
    }
  }
}
