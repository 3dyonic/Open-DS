{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ds.dev/schemas/doc-composites/type-roles.schema.json",
  "title": "Type roles",
  "description": "Each type role of a scheme, as a line set in the role's own tokens with its values. Drawn by the TypeRoles composite on Foundations › Typography.",
  "type": "object",
  "required": [
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "roles": {
      "type": "array",
      "description": "Every type role, largest first.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$",
            "description": "The role's name, such as display or body. Its tokens are type.<role>.*."
          },
          "text": {
            "type": "string",
            "description": "The line set in the role: the scheme's own content for that role."
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "For a line of several values, such as the data role's metrics: each value. The composite joins them."
          },
          "size": {
            "type": "string",
            "description": "type.<role>.font-size, in pixels when known."
          },
          "lineHeight": {
            "type": "string",
            "description": "type.<role>.line-height, in pixels when known."
          },
          "weight": {
            "type": "string",
            "description": "type.<role>.font-weight."
          }
        },
        "oneOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "parts"
            ]
          }
        ]
      }
    }
  }
}
