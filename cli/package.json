{
  "name": "open-ds",
  "version": "0.1.0",
  "description": "Create or add a complete design system to a project: tokens, components, Storybook, docs and agent files using open-ds schemes",
  "license": "MIT",
  "author": "3dyonic (https://3dyonic.com)",
  "homepage": "https://open-ds.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3dyonic/Open-DS.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/3dyonic/Open-DS/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "style-dictionary",
    "shadcn",
    "storybook",
    "docusaurus",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "open-ds": "bin/open-ds.js"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./mcp": "./src/mcp.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs",
    "test": "node --test",
    "pack": "npm pack --dry-run"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
