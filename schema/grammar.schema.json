{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3dyonic/Open-DS/schema/grammar.schema.json",
  "title": "Open DS grammar",
  "description": "The finite set of questions every Open DS scheme answers: reasons first, then scopes, plus the situations that usage rules answer and the shared component API. Written so an agent can read it cold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "version",
    "status",
    "description",
    "ai",
    "layers",
    "reasons",
    "scopes",
    "situations",
    "components",
    "component_keys"
  ],
  "properties": {
    "$schema": { "type": "string", "description": "Relative path to this schema." },
    "id": { "const": "open-ds-grammar", "description": "Fixed id of the grammar." },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the grammar.",
      "examples": ["0.1.0"]
    },
    "status": {
      "enum": ["draft", "curated"],
      "description": "draft until Yonatan curates the questions; curated after."
    },
    "description": { "type": "string", "minLength": 40, "description": "What the grammar is and how its parts relate." },
    "ai": {
      "type": "object",
      "description": "Guidance for an agent that reads this file.",
      "additionalProperties": false,
      "required": ["use_when", "how_to_read"],
      "properties": {
        "use_when": { "type": "string", "minLength": 1, "description": "When an agent should read the grammar." },
        "how_to_read": { "type": "string", "minLength": 1, "description": "How to follow answers, because links and tokens." }
      }
    },
    "layers": {
      "type": "array",
      "description": "The four layers of the grammar, in order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "enum": ["reasons", "scopes", "tokens", "component-api"], "description": "Layer id." },
          "description": { "type": "string", "minLength": 1, "description": "What the layer holds." }
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "description": "Reason groups: why the system exists. Answered before any scope.",
      "items": { "$ref": "#/$defs/group" }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "description": "Scope groups: the design decisions. Each scope answer points back to reason answers.",
      "items": { "$ref": "#/$defs/group" }
    },
    "situations": {
      "type": "array",
      "minItems": 1,
      "description": "Moments where people need to know which decision or component to use. Every scheme answers each one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "title", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Stable situation id. Machine use only; pages show the title.",
            "examples": ["number-in-table"]
          },
          "scope": { "type": "string", "pattern": "^[a-z-]+$", "description": "The scope or component the situation belongs to." },
          "title": { "type": "string", "minLength": 1, "description": "The situation in plain words, as shown to people." },
          "description": { "type": "string", "minLength": 1, "description": "One sentence that defines the situation for an agent." }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Components and the keys each one reads.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "keys"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$", "description": "Component group id." },
          "description": { "type": "string", "minLength": 1, "description": "What the component does." },
          "keys": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Component key ids the component reads."
          }
        }
      }
    },
    "component_keys": {
      "type": "array",
      "description": "The shared component API. Every scheme defines a value for every key.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "description", "default"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+(/[a-z-]+)+$",
            "description": "Key id: component / part / property. Becomes the CSS variable --component-part-property.",
            "examples": ["button/primary/background"]
          },
          "component": { "type": "string", "description": "The component group that owns the key." },
          "description": { "type": "string", "minLength": 1, "description": "What the key controls." },
          "default": {
            "type": "string",
            "description": "The semantic token path the key points to by default.",
            "examples": ["color.action.primary"]
          }
        }
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "description": "A reason or scope with its questions.",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+$", "description": "Group id; prefixes its question ids." },
        "kind": { "enum": ["reason", "scope"], "description": "Whether the group is a reason or a scope." },
        "title": { "type": "string", "minLength": 1, "description": "Group name in plain words." },
        "description": { "type": "string", "minLength": 1, "description": "What the group decides." },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" }, "description": "The questions." }
      }
    },
    "question": {
      "type": "object",
      "description": "One question with its possible answers.",
      "additionalProperties": false,
      "required": ["id", "text", "description", "options"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+\\.q\\d+$",
          "description": "Stable question id.",
          "examples": ["typography.q3"]
        },
        "text": { "type": "string", "minLength": 1, "description": "The question as asked." },
        "description": { "type": "string", "minLength": 1, "description": "What the question decides, for a person or an agent." },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" },
          "description": "The possible answers. Answers are semantic words, never raw values."
        }
      }
    },
    "option": {
      "type": "object",
      "description": "One possible answer.",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable option id." },
        "label": { "type": "string", "minLength": 1, "description": "The answer in plain words." }
      }
    }
  }
}
