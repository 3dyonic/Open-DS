{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3dyonic/Open-DS/schema/scheme.schema.json",
  "title": "Open DS scheme",
  "description": "A full design system as data: every grammar question answered with why and because, usage rules for every situation, voice and tone, scenarios, themes (brands × light and dark) and DTCG tokens in three tiers. Tools build CSS, components, docs and agent files from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "version",
    "status",
    "summary",
    "description",
    "ai",
    "scenarios",
    "voice",
    "inventory",
    "themes",
    "answers",
    "usage",
    "tokens"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Scheme id; also the CLI argument and the file name.",
      "examples": ["dense-data"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Scheme name as shown to people."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the scheme."
    },
    "status": {
      "enum": ["draft", "curated"],
      "description": "draft until Yonatan curates the answers."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "One sentence: what the scheme is for."
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "description": "A paragraph an agent can read cold to understand the scheme."
    },
    "ai": {
      "type": "object",
      "description": "Guidance for an agent choosing or applying the scheme.",
      "additionalProperties": false,
      "required": ["use_when", "avoid_when", "example_products"],
      "properties": {
        "use_when": {
          "type": "string",
          "minLength": 1,
          "description": "Products and contexts this scheme fits."
        },
        "avoid_when": {
          "type": "string",
          "minLength": 1,
          "description": "Products and contexts this scheme does not fit."
        },
        "example_products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Kinds of products that would pick this scheme."
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      },
      "description": "Use scenarios: real work, written from the answers to the use scenario questions (scenarios.q1, scenarios.q2) and other reasons."
    },
    "voice": {
      "type": "object",
      "description": "The written outputs of the voice and tone scope. Each lists the answers it follows. The tone per moment lives in usage, under the voice situations.",
      "required": ["summary", "principles", "words"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/output",
          "description": "The voice in one sentence."
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output"
          },
          "description": "Rules a writer or an agent follows."
        },
        "words": {
          "type": "object",
          "description": "Words to use and words to avoid.",
          "additionalProperties": false,
          "required": ["use", "avoid", "follows"],
          "properties": {
            "use": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Preferred words."
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Words to avoid."
            },
            "follows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.(q\\d+|roles|count|definition|values|lands)$"
              },
              "description": "Question ids whose answers this text was written from."
            }
          }
        },
        "brands": {
          "type": "object",
          "description": "Per-brand tone, for multi-brand schemes. Keys are brand ids.",
          "additionalProperties": {
            "$ref": "#/$defs/output"
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "follows", "in", "out"],
      "description": "The components this system carries: an output of the components answers, picked from the grammar catalogue. Anything not in the in list is out.",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What the inventory is."
        },
        "follows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+\\.(q\\d+|roles|count|definition|values|lands)$"
          },
          "description": "Question ids whose answers picked the inventory."
        },
        "in": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "why"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+$",
                "description": "A catalogue item id from the grammar."
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "description": "Why it is in or out, in one sentence."
              }
            }
          },
          "description": "The components in the inventory, each with why.",
          "minItems": 1
        },
        "out": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "why"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+$",
                "description": "A catalogue item id from the grammar."
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "description": "Why it is in or out, in one sentence."
              }
            }
          },
          "description": "Notable components left out, each with why. Every other catalogue item is out too."
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 2,
      "description": "Every brand × mode pair the scheme ships. Light and dark are standard for every brand.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "brand", "mode"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Theme id.",
            "examples": ["light", "birch-dark"]
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Brand id from tokens.brands."
          },
          "mode": {
            "enum": ["light", "dark"],
            "description": "Color mode."
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "description": "One answer for every grammar question.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "option", "why", "because"],
        "properties": {
          "question": {
            "type": "string",
            "pattern": "^[a-z]+\\.(q\\d+|roles|count|definition|values|lands)$",
            "description": "Grammar question id."
          },
          "option": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Chosen option id."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The reason in plain words."
          },
          "because": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+\\.(q\\d+|roles|count|definition|values|lands)$"
            },
            "description": "Earlier question ids whose answers pulled this one."
          }
        }
      }
    },
    "usage": {
      "type": "array",
      "minItems": 1,
      "description": "When to use what: one rule for every grammar situation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["situation", "use", "not", "why", "because"],
        "properties": {
          "situation": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Grammar situation id."
          },
          "use": {
            "type": "string",
            "minLength": 1,
            "description": "The token, component, variant or tone to use."
          },
          "not": {
            "type": "string",
            "minLength": 1,
            "description": "The tempting wrong choice."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The reason in plain words."
          },
          "because": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+\\.(q\\d+|roles|count|definition|values|lands)$"
            },
            "description": "Question ids whose answers this rule follows from."
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "description": "Real copy that follows the rule. Voice situations always have one."
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "DTCG tokens in three tiers. Primitives are the options; brands add brand primitives; semantics are the decisions (base, light, dark); component keys point to semantics. content holds the voice scope's tokens: the words components use.",
      "additionalProperties": false,
      "required": ["primitive", "brands", "semantic", "component", "content"],
      "properties": {
        "primitive": {
          "$ref": "#/$defs/group",
          "description": "Shared options. Components never read them."
        },
        "brands": {
          "type": "object",
          "minProperties": 1,
          "description": "Brand primitives keyed by brand id. A single-brand scheme has one brand, 'default'.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "description", "primitive"],
            "properties": {
              "label": {
                "type": "string",
                "description": "Brand name."
              },
              "description": {
                "type": "string",
                "description": "The brand in one sentence."
              },
              "primitive": {
                "$ref": "#/$defs/group",
                "description": "Brand color ramp, font families and corner picks."
              }
            }
          }
        },
        "semantic": {
          "type": "object",
          "description": "The decisions. base does not change by mode; light and dark hold the color and shadow decisions.",
          "additionalProperties": false,
          "required": ["base", "light", "dark"],
          "properties": {
            "base": {
              "$ref": "#/$defs/group",
              "description": "Mode-independent decisions: space, size, radius, type, motion."
            },
            "light": {
              "$ref": "#/$defs/group",
              "description": "Light mode color and elevation decisions."
            },
            "dark": {
              "$ref": "#/$defs/group",
              "description": "Dark mode color and elevation decisions; same paths as light."
            }
          }
        },
        "component": {
          "$ref": "#/$defs/group",
          "description": "The component API: one key per grammar component key."
        },
        "content": {
          "$ref": "#/$defs/group",
          "description": "Voice tokens: words for common actions, $type string. Not written to CSS."
        }
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "description": "A DTCG group: tokens and nested groups, with an optional $description.",
      "properties": {
        "$description": {
          "type": "string",
          "description": "What the group holds."
        }
      },
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "description": "A token or a nested group.",
          "anyOf": [
            {
              "$ref": "#/$defs/token"
            },
            {
              "$ref": "#/$defs/group"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "description": "A DTCG token. $value is a literal or a {path.to.token} reference.",
      "required": ["$value"],
      "additionalProperties": false,
      "properties": {
        "$value": {
          "description": "The value, or a reference such as {color.brand.600}."
        },
        "$type": {
          "enum": [
            "color",
            "dimension",
            "fontFamily",
            "fontWeight",
            "number",
            "duration",
            "cubicBezier",
            "shadow",
            "string"
          ],
          "description": "DTCG token type."
        },
        "$description": {
          "type": "string",
          "description": "What the token is for."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "follows"],
      "description": "Written text that is an output of answers, never an input.",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The text itself."
        },
        "follows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+\\.(q\\d+|roles|count|definition|values|lands)$"
          },
          "description": "Question ids whose answers this text was written from."
        }
      }
    }
  }
}
