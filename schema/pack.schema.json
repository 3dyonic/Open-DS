{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3dyonic/Open-DS/schema/pack.schema.json",
  "title": "Open DS pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "version",
    "scope",
    "order",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "global",
        "scoped"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "floors": {
      "$ref": "#/$defs/floors",
      "description": "Accessibility floors. Only the pack with id global is enforced on every recipe. See validator/README.md."
    },
    "tokenScopes": {
      "description": "Semantic token scopes for this release. Adding a scope is a pack change.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "scopeMappings": {
      "description": "Locked scope mappings. Each one needs a basis. There is no Proposed value.",
      "type": "array",
      "items": { "$ref": "#/$defs/scopeMapping" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "description": "ISO date copied from the source note. Never stamped at init.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": { "type": "string" },
        "option": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "reason"],
      "properties": {
        "question": { "type": "string" },
        "option": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 280 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "when": {
          "description": "AND list. The effect applies only when every clause matches a picked answer. Honored on recommends and discourages.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "option"],
            "properties": {
              "question": { "type": "string" },
              "option": { "type": "string" }
            }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "required",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "summary",
        "why",
        "when_to_choose",
        "trade_offs",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "when_to_choose": {
          "type": "string"
        },
        "trade_offs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidence_limited": {
          "type": "boolean"
        },
        "formula": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "recommends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "discourages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "fragment": {
          "description": "Repo-relative path to a hand-written file. A JSON file may carry a floors object.",
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "description": "Semantic scopes this answer's fragment may set. Other scopes keep their base value.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "cautions": {
          "description": "Optional notes copied onto token $extensions.openDs. They do not change basis or the reason line.",
          "type": "array",
          "items": { "$ref": "#/$defs/caution" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "summary",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "prompt": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "why_care": {
          "type": "string",
          "minLength": 1
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feeds_into": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "ref": {
          "type": "string",
          "pattern": "^global:[a-z0-9-]+$"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "affects": {
          "description": "What this question changes. Omit until known. An empty list warns.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "feeds_into": {
          "description": "Question ids this question feeds. Each id must exist and be backed by requires, discourages, or recommends.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "why_care": {
          "description": "One sentence, 25 words or fewer.",
          "type": "string"
        },
        "axis": {
          "description": "Catalog group for this question. Read from the pack. Falls back to the question id.",
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "caution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "quote": { "type": "string" },
        "checked": { "type": "string" }
      }
    },
    "scopeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "basis"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$" },
        "basis": { "enum": ["sourced", "floor", "your-pick"] },
        "value": {}
      }
    },
    "componentClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "flags": {
          "type": "array",
          "items": { "enum": ["destructive", "payment", "legal-commitment"] }
        },
        "reversible": {
          "type": "boolean",
          "description": "Component default. The floor passes when any one of reversible, checked, or confirmed is true."
        },
        "checked": {
          "type": "boolean",
          "description": "Component default. The floor passes when any one of reversible, checked, or confirmed is true."
        },
        "confirmed": {
          "type": "boolean",
          "description": "Component default. The floor passes when any one of reversible, checked, or confirmed is true."
        },
        "prevention": {
          "description": "Which method this component uses. A component default. The floor does not read this field.",
          "enum": ["reversible", "checked", "confirmed"]
        },
        "critical": { "type": "boolean" },
        "hiddenBy": { "enum": ["hover", "accordion", "visible"] }
      }
    },
    "floors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declared floor claims. The validator compares these numbers to WCAG 2.2. It does not measure pixels or contrast.",
      "properties": {
        "contrast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "number", "description": "Declared text contrast ratio. Floor is 4.5 (WCAG 2.2 1.4.3)." },
            "nonText": { "type": "number", "description": "Declared non-text contrast ratio. Floor is 3 (WCAG 2.2 1.4.11)." }
          }
        },
        "resize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "textResizePercent": { "type": "number", "description": "Declared resize percent. Floor is 200 (WCAG 2.2 1.4.4)." },
            "contentLost": { "type": "boolean", "description": "True when content or functionality is lost at that size." }
          }
        },
        "textSpacing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lineHeight": { "type": "number", "description": "Supported line height as a multiple of font size. Floor is 1.5 (WCAG 2.2 1.4.12)." },
            "paragraphSpacing": { "type": "number", "description": "Supported paragraph spacing as a multiple of font size. Floor is 2." },
            "letterSpacing": { "type": "number", "description": "Supported letter spacing as a multiple of font size. Floor is 0.12." },
            "wordSpacing": { "type": "number", "description": "Supported word spacing as a multiple of font size. Floor is 0.16." }
          }
        },
        "targetSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minPx": { "type": "number", "description": "Declared minimum target size in CSS pixels. Floor is 24 (WCAG 2.2 2.5.8)." },
            "sufficientSpacing": { "type": "boolean", "description": "True when a smaller target has the 2.5.8 spacing exception." }
          }
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentClaim" }
        }
      }
    }
  }
}
