{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3dyonic/Open-DS/schema/pack.schema.json",
  "title": "Open DS pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "version",
    "scope",
    "order",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "global",
        "scoped"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": { "type": "string" },
        "option": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "reason"],
      "properties": {
        "question": { "type": "string" },
        "option": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "required",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "summary",
        "why",
        "when_to_choose",
        "trade_offs",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "when_to_choose": {
          "type": "string"
        },
        "trade_offs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "formula": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "recommends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "discourages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "summary",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "prompt": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "ref": {
          "type": "string",
          "pattern": "^global:[a-z0-9-]+$"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    }
  }
}
