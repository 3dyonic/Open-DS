{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3dyonic/Open-DS/schema/recipe.schema.json",
  "title": "Open DS recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "serves", "packs", "picks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "provisional": { "type": "boolean" },
    "summary": { "type": "string" },
    "serves": { "type": "string", "minLength": 1 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "picks": {
      "type": "array",
      "items": { "$ref": "#/$defs/pick" }
    }
  },
  "$defs": {
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "option", "rationale"],
      "properties": {
        "question": { "type": "string" },
        "option": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 280 },
        "params": { "type": "object" }
      }
    }
  }
}
