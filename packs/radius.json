{
  "id": "radius",
  "title": "Radius",
  "summary": "Starter decisions for corner radius.",
  "version": "0.1.0",
  "scope": "scoped",
  "order": 7,
  "questions": [
    {
      "id": "radius-base",
      "prompt": "What is the base radius?",
      "summary": "The radius of a normal control.",
      "required": true,
      "options": [
        {
          "id": "sharp",
          "label": "0",
          "summary": "Square corners.",
          "why": "Square corners use a radius of 0. You get hard edges on every control and surface.",
          "when_to_choose": "Choose this if the brand should feel sharp.",
          "trade_offs": [
            "You give up rounded corners on controls and cards"
          ],
          "sources": [
            {
              "name": "Tailwind",
              "title": "Border radius",
              "url": "https://tailwindcss.com/docs/border-radius"
            },
            {
              "name": "Material Web",
              "title": "Shape tokens",
              "url": "https://raw.githubusercontent.com/material-components/material-web/main/tokens/versions/v0_192/_md-sys-shape.scss"
            }
          ]
        },
        {
          "id": "radius-4",
          "label": "4",
          "summary": "A small radius.",
          "why": "A 4 px radius softens a corner without looking round.",
          "when_to_choose": "Choose this if you want only a slight softening.",
          "trade_offs": [
            "The change can be missed at a glance"
          ],
          "sources": [
            {
              "name": "Tailwind",
              "title": "Border radius",
              "url": "https://tailwindcss.com/docs/border-radius"
            },
            {
              "name": "Material Web",
              "title": "Shape tokens",
              "url": "https://raw.githubusercontent.com/material-components/material-web/main/tokens/versions/v0_192/_md-sys-shape.scss"
            }
          ]
        },
        {
          "id": "radius-8",
          "label": "8",
          "summary": "A medium radius.",
          "why": "An 8 px radius is the `lg` step in Tailwind and the small step in Material.",
          "when_to_choose": "Choose this if you want a radius that Tailwind and Material both offer.",
          "trade_offs": [
            "It does not match a brand with square corners"
          ],
          "sources": [
            {
              "name": "Tailwind",
              "title": "Border radius",
              "url": "https://tailwindcss.com/docs/border-radius"
            },
            {
              "name": "Material Web",
              "title": "Shape tokens",
              "url": "https://raw.githubusercontent.com/material-components/material-web/main/tokens/versions/v0_192/_md-sys-shape.scss"
            }
          ]
        },
        {
          "id": "radius-12",
          "label": "12",
          "summary": "A large radius.",
          "why": "A 12 px radius is the medium step in Material and the `xl` step in Tailwind. Primer calls it `large`.",
          "when_to_choose": "Choose this if you want clearly rounded corners on cards and controls.",
          "trade_offs": [
            "It does not match a brand with square or slightly rounded corners"
          ],
          "sources": [
            {
              "name": "Material Web",
              "title": "Shape tokens",
              "url": "https://raw.githubusercontent.com/material-components/material-web/main/tokens/versions/v0_192/_md-sys-shape.scss"
            },
            {
              "name": "Tailwind",
              "title": "Border radius",
              "url": "https://tailwindcss.com/docs/border-radius"
            },
            {
              "name": "Primer",
              "title": "Size primitives",
              "url": "https://primer.style/foundations/primitives/size"
            }
          ]
        },
        {
          "id": "pill",
          "label": "Pill",
          "summary": "Fully rounded ends.",
          "why": "A pill radius rounds short controls fully.",
          "when_to_choose": "Choose this if buttons should look like pills.",
          "trade_offs": [
            "Large surfaces can turn into circles"
          ],
          "sources": [
            {
              "name": "Tailwind",
              "title": "Border radius",
              "url": "https://tailwindcss.com/docs/border-radius"
            },
            {
              "name": "Material Web",
              "title": "Shape tokens",
              "url": "https://raw.githubusercontent.com/material-components/material-web/main/tokens/versions/v0_192/_md-sys-shape.scss"
            }
          ]
        }
      ]
    },
    {
      "id": "radius-progression",
      "prompt": "How do radius steps grow?",
      "summary": "How larger surfaces relate to the base radius.",
      "required": true,
      "options": [
        {
          "id": "none",
          "label": "One radius",
          "summary": "Every corner uses the base.",
          "why": "One radius keeps every corner the same.",
          "when_to_choose": "Choose this if you do not want a radius scale.",
          "trade_offs": [
            "Cards and inputs look identical"
          ],
          "sources": [
            {
              "name": "Pico CSS",
              "title": "CSS variables",
              "url": "https://picocss.com/docs/css-variables"
            }
          ],
          "formula": "A single radius value."
        },
        {
          "id": "linear",
          "label": "Linear",
          "summary": "Add a fixed amount each step.",
          "why": "Linear radius adds a fixed amount per step, for example 4, 8, 12, 16. The Material scale starts this way.",
          "when_to_choose": "Choose this if the steps should be even.",
          "trade_offs": [
            "Large steps grow no faster than small ones"
          ],
          "sources": [
            {
              "name": "Material Web",
              "title": "Shape tokens",
              "url": "https://raw.githubusercontent.com/material-components/material-web/main/tokens/versions/v0_192/_md-sys-shape.scss"
            }
          ],
          "formula": "Each step adds a fixed radius."
        },
        {
          "id": "geometric",
          "label": "Geometric",
          "summary": "Multiply the base each step.",
          "why": "Each radius step multiplies the base, so large corners grow quickly.",
          "when_to_choose": "Choose this if cards should be much rounder than inputs.",
          "trade_offs": [
            "The steps are harder to remember"
          ],
          "sources": [
            {
              "name": "Tailwind",
              "title": "Customizing colors",
              "url": "https://tailwindcss.com/docs/colors"
            }
          ],
          "formula": "Each step multiplies the base radius.",
          "evidence_limited": true
        }
      ]
    },
    {
      "id": "css-unit",
      "prompt": "Which unit does radius use?",
      "summary": "References the global unit.",
      "required": true,
      "ref": "global:css-unit"
    }
  ]
}
