{
  "primitive": {
    "color": {
      "paper": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.9804, 0.9647, 0.9529], "hex": "#faf6f3" }
      },
      "ink": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.2314, 0.1412, 0.1098], "hex": "#3b241c" }
      },
      "terracotta": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.7686, 0.3843, 0.1765], "hex": "#c4622d" }
      }
    },
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": ["ui-sans-serif", "system-ui", "sans-serif"] }
      },
      "size": {
        "body": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } }
      },
      "lineHeight": {
        "body": { "$type": "number", "$value": 1.5 }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": { "value": 0.25, "unit": "rem" } },
      "2": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "3": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
      "4": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } }
    },
    "motion": {
      "quick": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } }
    }
  },
  "semantic": {
    "color": {
      "surface": { "$type": "color", "$value": "{primitive.color.paper}" },
      "on-surface": { "$type": "color", "$value": "{primitive.color.ink}" },
      "accent": { "$type": "color", "$value": "{primitive.color.terracotta}" },
      "on-accent": { "$type": "color", "$value": "{primitive.color.paper}" }
    }
  },
  "component": {
    "button": {
      "background": { "$type": "color", "$value": "{semantic.color.accent}" },
      "label": { "$type": "color", "$value": "{semantic.color.on-accent}" }
    },
    "card": {
      "background": { "$type": "color", "$value": "{semantic.color.surface}" },
      "label": { "$type": "color", "$value": "{semantic.color.on-surface}" }
    }
  }
}
